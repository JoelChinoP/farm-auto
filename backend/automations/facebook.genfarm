        "value": "",
        "secret": false
      },
      {
        "id": "toolbarLikePattern",
        "name": "toolbarLikePattern",
        "label": "Selector: Like activo/inactivo",
        "value": "^(me gusta|like|ya no me gusta|unlike)(,.*)?$",
        "secret": false
      },
      {
        "id": "toolbarCommentPattern",
        "name": "toolbarCommentPattern",
        "label": "Selector: abrir comentarios",
        "value": "^(comentar|comment)(,.*)?$",
        "secret": false
      },
      {
        "id": "toolbarSharePattern",
        "name": "toolbarSharePattern",
        "label": "Selector: abrir compartir",
        "value": "^(compartir|share)(,.*)?$",
        "secret": false
      },
      {
        "id": "commentEditorClassPattern",
        "name": "commentEditorClassPattern",
        "label": "Selector: clase del editor",
        "value": "[.](MultiAutoCompleteTextView|EditText)$",
        "secret": false
      },
      {
        "id": "shareSubmitPattern",
        "name": "shareSubmitPattern",
        "label": "Selector: Compartir ahora",
        "value": "^(compartir ahora|compartir en feed|share now|share to feed)$",
        "secret": false
      },
      {
        "id": "publicAudiencePattern",
        "name": "publicAudiencePattern",
        "label": "Selector: control clickable de audiencia publica",
        "value": "^(publico|public)\\b",
        "secret": false
      },
      {
        "id": "commentConfirmedPattern",
        "name": "commentConfirmedPattern",
        "label": "Selector: comentario confirmado",
        "value": "comentario.*(agregado|publicado|enviado)|comment.*(added|posted)",
        "secret": false
      },
      {
        "id": "shareConfirmedPattern",
        "name": "shareConfirmedPattern",
        "label": "Selector: compartir confirmado",
        "value": "compartio|compartid[oa]|shared|publicacion.*(creada|publicada)",
        "secret": false
      },
      {
        "id": "fb_error",
        "name": "fb_error",
        "label": "fb_error",
        "value": "Fallo en un nodo nativo; consulta el nodo marcado Failed en el registro.",
        "secret": false
      },
      {
        "id": "fb_summary",
        "name": "fb_summary",
        "label": "fb_summary",
        "value": "",
        "secret": false
      },
      {
        "id": "diagnostic_only",
        "name": "diagnostic_only",
        "label": "Diagnóstico sin publicar",
        "value": false,
        "secret": false
      }
    ],
    "flow": {
      "nodes": [
        {
          "id": "social_start",
          "type": "input",
          "position": {
            "x": 80,
            "y": 180
          },
          "data": {
            "action": "Start",
            "options": {},
            "successNode": "fb_wake",
            "failNode": null
          },
          "label": "Start",
          "sourcePosition": "right",
          "targetPosition": "left",
          "deletable": false,
          "class": ""
        },
        {
          "id": "social_force_stop",
          "type": "custom",
          "position": {
            "x": 540,
            "y": 40
          },
          "data": {
            "icon": "terminal",
            "action": "Adb",
            "options": {
              "command": "am force-stop com.facebook.lite",
              "outputVariable": null,
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "45",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "social_open_app",
            "failNode": "social_error"
          },
          "label": "Facebook Lite · Cerrar aplicación",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_open_app",
          "type": "custom",
          "position": {
            "x": 780,
            "y": 40
          },
          "data": {
            "icon": "play",
            "action": "StartApp",
            "options": {
              "packageName": "com.facebook.lite",
              "timeout": "45",
              "disabled": false,
              "nodeSleep": "3",
              "nodeTimeout": "60",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "social_content",
            "failNode": "social_error"
          },
          "label": "Facebook Lite · Abrir aplicación",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_content",
          "type": "custom",
          "position": {
            "x": 1020,
            "y": 40
          },
          "data": {
            "icon": "terminal",
            "action": "Adb",
            "options": {
              "command": "am start -W -a android.intent.action.VIEW -d '${contentUrl}' -p com.facebook.lite",
              "outputVariable": null,
              "disabled": false,
              "nodeSleep": "4",
              "nodeTimeout": "60",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "social_live_ready",
            "failNode": "social_error"
          },
          "label": "Facebook Lite · Abrir contenido",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_live_ready",
          "type": "custom",
          "position": {
            "x": 1020,
            "y": -280
          },
          "data": {
            "icon": "element-exists",
            "action": "ElementExists",
            "options": {
              "xpath": "//*[@package='com.facebook.lite' and (@class='androidx.recyclerview.widget.RecyclerView' or @resource-id='com.facebook.lite:id/video_view')]",
              "timeout": "45",
              "disabled": false,
              "nodeSleep": "2",
              "nodeTimeout": "55",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "social_live_detect",
            "failNode": "social_live_detect"
          },
          "label": "Facebook Lite · Esperar interfaz",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_live_detect",
          "type": "custom",
          "position": {
            "x": 1260,
            "y": -80
          },
          "data": {
            "icon": "image",
            "action": "Image",
            "options": {
              "inputBase64": "data:image/png;base64,",
              "action": "exists",
              "timeout": "8",
              "indexImage": "0",
              "clickDelay": "0",
              "threshold": "0.99",
              "rgb": "true",
              "matchingMethod": "tpl",
              "outputPositionsVariable": null,
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "20",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "social_live_open",
            "failNode": "social_live_detect_variant"
          },
          "label": "Facebook Lite · Detectar LIVE",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_live_detect_variant",
          "type": "custom",
          "position": {
            "x": 1260,
            "y": -280
          },
          "data": {
            "icon": "image",
            "action": "Image",
            "options": {
              "inputBase64": "data:image/png;base64,",
              "action": "exists",
              "timeout": "5",
              "indexImage": "0",
              "clickDelay": "0",
              "threshold": "0.99",
              "rgb": "true",
              "matchingMethod": "tpl",
              "outputPositionsVariable": null,
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "20",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "social_live_open",
            "failNode": "social_live_detect_vivo"
          },
          "label": "Facebook Lite · Detectar LIVE (variante)",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_live_detect_vivo",
          "type": "custom",
          "position": {
            "x": 1260,
            "y": -480
          },
          "data": {
            "icon": "image",
            "action": "Image",
            "options": {
              "inputBase64": "data:image/png;base64,",
              "action": "exists",
              "timeout": "5",
              "indexImage": "0",
              "clickDelay": "0",
              "threshold": "0.99",
              "rgb": "true",
              "matchingMethod": "tpl",
              "outputPositionsVariable": null,
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "20",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "social_live_open",
            "failNode": "social_success"
          },
          "label": "Facebook Lite · Detectar LIVE (En vivo)",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_live_open",
          "type": "custom",
          "position": {
            "x": 1500,
            "y": -80
          },
          "data": {
            "icon": "touch",
            "action": "Javascript",
            "options": {
              "script": "const app = \"(@package='com.facebook.lite' or @package='com.facebook.katana')\";\nconst video = \"//*[\" + app + \" and (@resource-id='com.facebook.lite:id/video_view' or @resource-id='com.facebook.katana:id/video_view')]\";\nconst inFeed = video + \"[ancestor::*[@class='androidx.recyclerview.widget.RecyclerView']]/ancestor::*[@clickable='true'][1]\";\nconst preview = \"//*[(\" + app.slice(1, -1) + \") and @class='androidx.recyclerview.widget.RecyclerView']/*/*[@clickable='true']/*[@class='android.view.ViewGroup' and @clickable='false']/*[@class='android.view.View' and @clickable='true'] | \" +\n  \"//*[(\" + app.slice(1, -1) + \") and @class='android.widget.Button' and (@content-desc='Detalles del video' or @content-desc='Video details')]\";\nconst player = video + \"[ancestor::*[@resource-id='com.facebook.lite:id/videoview' or @resource-id='com.facebook.katana:id/videoview']]\";\nlet clicks = 0;\nlet lastClick = -4;\nlet stable = 0;\nlet lastError = '';\nfor (let check = 0; check < 15; check++) {\n  try {\n    const xml = await this.getXml();\n    if (await this.queryXpath(player, xml)) {\n      if (++stable >= 2) return;\n    } else {\n      stable = 0;\n      if (clicks < 2 && check - lastClick >= 4) {\n        const element = (await this.queryXpath('(' + inFeed + ')[1]', xml)) ||\n          (await this.queryXpath('(' + preview + ')[1]', xml));\n        if (element) {\n          clicks++;\n          lastClick = check;\n          await element.click();\n        }\n      }\n    }\n    lastError = '';\n  } catch (error) {\n    stable = 0;\n    lastError = String(error && error.message || error);\n    if (!/HTTP 50[234]|status code 50[234]|ECONNRESET|ECONNREFUSED|ETIMEDOUT|socket hang up|timed out/i.test(lastError)) throw error;\n  }\n  await genfarmerSleep(1);\n}\nthrow new Error('No se pudo confirmar el reproductor LIVE tras la espera.' + (lastError ? ' ' + lastError : ''));",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "45",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "social_success",
            "failNode": "social_error"
          },
          "label": "Facebook Lite · Abrir video LIVE",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_success",
          "type": "custom",
          "position": {
            "x": 1740,
            "y": 180
          },
          "data": {
            "icon": "log",
            "action": "Log",
            "options": {
              "log": "Contenido abierto correctamente.",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "30",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "fb_actions",
            "failNode": null
          },
          "label": "Contenido abierto",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_error",
          "type": "custom",
          "position": {
            "x": 1500,
            "y": 600
          },
          "data": {
            "icon": "log",
            "action": "Log",
            "options": {
              "log": "No se pudo abrir el contenido en Facebook Lite.",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "30",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "social_stop",
            "failNode": null
          },
          "label": "Registrar error",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "fb_wake",
          "type": "custom",
          "position": {
            "x": 300,
            "y": 40
          },
          "data": {
            "icon": "terminal",
            "action": "Adb",
            "options": {
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "30",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": "",
              "command": "input keyevent KEYCODE_WAKEUP",
              "outputVariable": null
            },
            "successNode": "social_force_stop",
            "failNode": "social_error"
          },
          "label": "Preparar pantalla · Encender",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "fb_actions",
          "type": "custom",
          "position": {
            "x": 1980,
            "y": 180
          },
          "data": {
            "icon": "code",
            "action": "Javascript",
            "options": {
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "450",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": "",
              "script": "'use strict';\n\nlet liteSelectors;\n\n// Adapted from v0/facebook_lite_ui.js. build_actions.py embeds this and Windows OCR.\n// The preceding original flow owns opening; no open_result variable is required here.\nasync function facebookLiteUI(ctx, ocrSource) {\n  const fs = require('fs');\n  const path = require('path');\n  const { spawn } = require('child_process');\n  const { nativeImage } = require('electron');\n  const v = ctx.variables;\n  const ui = ctx.clientUiAutomator;\n  const pkg = 'com.facebook.lite';\n  const enabled = value => value === true || value === 1 || /^(true|1)$/i.test(String(value));\n  const actions = { like: enabled(v.like), comment: enabled(v.comment), share: enabled(v.share) };\n  const diagnostic = enabled(v.diagnostic_only);\n  const targetText = normalizeLiteText(v.targetText);\n  const selector = (name, fallback) => {\n    try { return new RegExp(String(v[name] || fallback)); }\n    catch (_) { throw new Error('Selector invalido: ' + name + '.'); }\n  };\n  liteSelectors = {\n    toolbarLike: selector('toolbarLikePattern', '^(me gusta|like|ya no me gusta|unlike)(,.*)?$'),\n    toolbarComment: selector('toolbarCommentPattern', '^(comentar|comment)(,.*)?$'),\n    toolbarShare: selector('toolbarSharePattern', '^(compartir|share)(,.*)?$'),\n    commentEditorClass: selector('commentEditorClassPattern', '[.](MultiAutoCompleteTextView|EditText)$'),\n    shareSubmit: selector('shareSubmitPattern', '^(compartir ahora|compartir en feed|share now|share to feed)$'),\n    publicAudience: selector('publicAudiencePattern', '^(publico|public)\\b'),\n    commentConfirmed: selector('commentConfirmedPattern', 'comentario.*(agregado|publicado|enviado)|comment.*(added|posted)'),\n    shareConfirmed: selector('shareConfirmedPattern', 'compartio|compartid[oa]|shared|publicacion.*(creada|publicada)')\n  };\n  v.fb_error = '';\n  v.fb_summary = '';\n  if (!Object.values(actions).some(Boolean)) { v.fb_summary = 'contenido abierto; acciones desactivadas'; return; }\n  const liveUrl = /\\/(?:share\\/v|[0-9]+\\/videos\\/[0-9]+)(?:[/?#]|$)/i.test(String(v.contentUrl));\n  const reel = /\\/(share\\/r|reel|reels)\\//i.test(String(v.contentUrl));\n  const folder = path.join(require('os').tmpdir(), 'opencode', 'GenFarmer-FacebookActions',\n    String(ctx.runId || Date.now()).replace(/[^\\w-]/g, '_'), ctx.deviceId);\n  fs.mkdirSync(folder, { recursive: true });\n  const result = { serial: ctx.deviceId, url: v.contentUrl, kind: liveUrl ? 'video' : reel ? 'reel' : 'post',\n    status: 'running', mode: diagnostic ? 'diagnostic' : 'publish', actions: {}, evidence: folder };\n  const deadline = Date.now() + 420000;\n  let sequence = 0;\n  let identity = '';\n  let postVisualText = '';\n  let reelDescription = '';\n  let reelPaused = false;\n  let reelExpandedCaption = false;\n  let liveIdentity = '';\n  let commentKeysBefore = [];\n  let toastEnabled = false;\n\n  function check() {\n    if (ctx.actionProcessed || Date.now() > deadline) throw new Error('Ejecucion interrumpida o plazo UI agotado.');\n  }\n  async function wait(ms) {\n    const end = Date.now() + ms;\n    while (Date.now() < end) {\n      check();\n      await new Promise(resolve => setTimeout(resolve, Math.min(200, end - Date.now())));\n    }\n  }\n  function save() { fs.writeFileSync(path.join(folder, 'result.json'), JSON.stringify(result, null, 2)); }\n  function report(message) {\n    save();\n    if (ctx.logCallback) ctx.logCallback({ logType: 'Info', logText: message, action: { id: 'fb_actions', label: 'UI Facebook Lite' } });\n  }\n  async function rpc(method, params) {\n    check();\n    // attempt=5 disables GenFarmer's RPC replay: a lost reply must not duplicate a send.\n    const response = await ui.callRpc(method, params, 10000, 5);\n    check();\n    if (response.error || response.result === false) throw new Error('Operacion UI no confirmada: ' + method);\n    return response.result;\n  }\n  async function screen(label) {\n    check();\n    let nodes;\n    for (let attempt = 0; attempt < 8; attempt++) {\n      let xml;\n      try {\n        xml = await ctx.getXml();\n        check();\n      } catch (error) {\n        if (!/HTTP 50[234]|status code 50[234]|ECONNRESET|ECONNREFUSED|ETIMEDOUT|socket hang up|timed out/i.test(String(error && error.message || error))) throw error;\n        await wait(1000);\n        continue;\n      }\n      fs.writeFileSync(path.join(folder, (++sequence) + '-' + label + '.xml'), xml);\n      nodes = parseLiteXml(xml);\n      if (nodes.some(n => n.package === pkg)) break;\n      await wait(750);\n    }\n    if (!nodes || !nodes.some(n => n.package === 'com.facebook.lite')) throw new Error('Facebook Lite no esta en primer plano; revisar pantalla y sesion.');\n    const list = nodes.filter(n => n.package === pkg && n.enabled !== 'false' && n.visible !== 'false');\n    if (list.some(n => /^(iniciar sesion|log in|confirmar tu identidad|contenido no disponible|este contenido no esta disponible)/i.test(n.label))) {\n      throw new Error('Sesion o contenido no disponible.');\n    }\n    return list;\n  }\n  async function photo(label) {\n    check();\n    const buffer = await ui.screenShotToBuffer();\n    check();\n    const image = nativeImage.createFromBuffer(buffer);\n    if (image.isEmpty()) throw new Error('Captura de pantalla vacia.');\n    const file = path.join(folder, (++sequence) + '-' + label + '.png');\n    fs.writeFileSync(file, image.toPNG());\n    return { image, file };\n  }\n  async function recognize(label, region = null) {\n    const shot = await photo(label);\n    let imagePath = shot.file, crop = null, originalSize;\n    if (region) {\n      originalSize = shot.image.getSize();\n      const left = Math.max(0, region[0] - 24), top = Math.max(0, region[1] - 12);\n      const right = Math.min(originalSize.width, region[2] + 6), bottom = Math.min(originalSize.height, region[3] + 12);\n      crop = { left, top, width: right - left, height: bottom - top };\n      const bitmap = shot.image.toBitmap({ scaleFactor: 1 });\n      const buffer = Buffer.alloc(crop.width * crop.height * 4);\n      for (let y = 0; y < crop.height; y++) {\n        const offset = ((top + y) * originalSize.width + left) * 4;\n        bitmap.copy(buffer, y * crop.width * 4, offset, offset + crop.width * 4);\n      }\n      liteCaptionMask(buffer);\n      imagePath = shot.file + '-region.png';\n      const image = nativeImage.createFromBitmap(buffer, { width: crop.width, height: crop.height, scaleFactor: 1 });\n      fs.writeFileSync(imagePath, image.resize({ width: crop.width * 2, height: crop.height * 2, quality: 'best' }).toPNG());\n    }\n    const text = await new Promise((resolve, reject) => {\n      const child = spawn('powershell.exe', ['-NoProfile', '-NonInteractive', '-EncodedCommand',\n        Buffer.from(\"$ProgressPreference = 'SilentlyContinue'\\n\" + ocrSource, 'utf16le').toString('base64')], { windowsHide: true });\n      let output = '', errors = '';\n      const timer = setInterval(() => {\n        if (ctx.actionProcessed || Date.now() > deadline) child.kill();\n      }, 200);\n      const limit = setTimeout(() => child.kill(), 25000);\n      child.stdout.on('data', chunk => { output += chunk.toString('utf8'); });\n      child.stderr.on('data', chunk => { errors += chunk.toString('utf8'); });\n      child.on('error', error => { clearInterval(timer); clearTimeout(limit); reject(error); });\n      child.on('close', code => {\n        clearInterval(timer); clearTimeout(limit);\n        if (code !== 0) reject(new Error('Reconocimiento visual no disponible: ' + errors.slice(0, 300)));\n        else resolve(output);\n      });\n      child.stdin.on('error', () => {});\n      child.stdin.end(imagePath);\n    });\n    check();\n    const data = JSON.parse(text.replace(/^\\uFEFF/, ''));\n    if (crop) {\n      const scaleX = data.width / crop.width, scaleY = data.height / crop.height;\n      data.lines.forEach(line => {\n        line.x = crop.left + line.x / scaleX; line.y = crop.top + line.y / scaleY;\n        line.width /= scaleX; line.height /= scaleY;\n      });\n      data.width = originalSize.width; data.height = originalSize.height;\n    }\n    data.lines.forEach(line => { line.label = normalizeLiteText(line.text); line.bounds = [line.x, line.y, line.x + line.width, line.y + line.height]; });\n    if (label.startsWith('live-identify')) data.liveBadge = liteLiveBadge(shot.image);\n    fs.writeFileSync(shot.file + '.json', JSON.stringify(data, null, 2));\n    return data;\n  }\n  function named(nodes, pattern) {\n    const matches = nodes.filter(n => n.clickable === 'true' && pattern.test(n.label));\n    return matches.length === 1 ? matches[0] : null;\n  }\n  function editor(nodes) {\n    const matches = nodes.filter(n => liteSelectors.commentEditorClass.test(n.class));\n    return matches.length === 1 ? matches[0] : null;\n  }\n  async function tap(node) {\n    check();\n    if (!node || !node.bounds || node.bounds[2] <= node.bounds[0] || node.bounds[3] - node.bounds[1] < 15) {\n      throw new Error('Control ausente, ambiguo u oculto.');\n    }\n    await rpc('click', [Math.round((node.bounds[0] + node.bounds[2]) / 2), Math.round((node.bounds[1] + node.bounds[3]) / 2)]);\n  }\n  async function navigate(node) {\n    try { await tap(node); }\n    catch (error) {\n      if (error.message !== 'Operacion UI no confirmada: click') throw error;\n      // Android can return false although the new screen is already open. The\n      // caller verifies that transition; do not repeat the tap on the new view.\n      result.navigationReplyUncertain = (result.navigationReplyUncertain || 0) + 1;\n    }\n  }\n  function toolbar(nodes) { return liteToolbar(nodes, reel); } async function dismissKeyboard(nodes) { let raw; try { raw = parseLiteXml(await ctx.getXml()); } catch (_) { return nodes; } const page = nodes.find(n => n['resource-id'] === 'com.facebook.lite:id/main_layout'); const pageBottom = page ? page.bounds[3] : Math.max(...nodes.map(n => n.bounds[3])); const screenBottom = Math.max(...raw.map(n => n.bounds[3])); if (pageBottom >= screenBottom * .9) return nodes; await rpc('pressKey', ['back']); await wait(500); return screen('comment-keyboard-dismissed'); }\n  async function scrollPost(nodes, revealComment = false) {\n    if (reel) throw new Error('No se desliza un reel: cambiaria la publicacion.');\n    const area = nodes.filter(n => n.scrollable === 'true').sort((a, b) => areaOf(b) - areaOf(a))[0];\n    if (!area) throw new Error('No se encontro el contenedor desplazable de la publicacion.');\n    const b = area.bounds;\n    const x = Math.round((b[0] + b[2]) / 2);\n    await rpc('swipe', [x, Math.round(b[1] + (b[3] - b[1]) * (revealComment ? .70 : .78)),\n      x, Math.round(b[1] + (b[3] - b[1]) * (revealComment ? .55 : .36)), revealComment ? 35 : 55]);\n    await wait(700);\n  }\n  async function locatePost() {\n    const loadDeadline = Date.now() + (identity ? 20000 : 90000);\n    while (Date.now() < loadDeadline) {\n      let nodes = await screen('post');\n      let bar = toolbar(nodes);\n      if (bar || (!reel && editor(nodes))) {\n        if (reel && bar && (!reelPaused || !named(nodes, /^(play|reproducir)$/))) {\n          if (!named(nodes, /^(play|reproducir)$/)) {\n            const video = nodes.find(n => n['resource-id'] === 'com.facebook.lite:id/video_view') ||\n              nodes.find(n => n.class === 'androidx.recyclerview.widget.RecyclerView' && n.scrollable === 'true');\n            if (!video) throw new Error('No se identifico la superficie del reel.');\n            await navigate(video);\n          }\n          for (let i = 0; i < 8; i++) {\n            await wait(500);\n            nodes = await screen('reel-pause');\n            if (named(nodes, /^(play|reproducir)$/)) { reelPaused = true; break; }\n          }\n          if (!reelPaused) throw new Error('No se pudo confirmar la pausa del reel.');\n          bar = toolbar(nodes);\n        }\n        const visual = await recognize('post-identify');\n        postVisualText = (postVisualText + ' ' + visual.lines.map(line => line.label).join(' ')).trim();\n        if (visual.lines.some(l => /has compartido|you (have )?shared|publicacion compartida/.test(l.label))) {\n          await wait(1200);\n          continue;\n        }\n        // Some Lite/device combinations omit \"Reels\" entirely from full-screen OCR.\n        // A paused native player + the unique right-hand action column identifies the layout;\n        // the caption is still checked below before every action.\n        const structuralReel = reel && reelPaused && liteReelLayout(nodes, bar);\n        const title = visual.lines.find(l => { const label = l.label.replace(/^[^a-z0-9]+/, ''); return reel ? /^reels$/i.test(label) : /^(publicacion de |.*'s post|post by )/.test(label); }) ||\n          (structuralReel ? { label: 'reels' } : null);\n        if (!title) {\n          if (visual.lines.some(l => /contenido.*no.*disponible|iniciar sesion|log in|sin conexion|no hay conexion/.test(l.label))) {\n            throw new Error('Publicacion no disponible o sin conexion.');\n          }\n        } else {\n          const heading = title.label.replace(/^[^a-z0-9]+/, '').replace(/\\s+[qo0]$/, '');\n          if (!identity) identity = heading;\n          if (identity !== heading) throw new Error('La publicacion cambio durante la ejecucion.');\n          if (reel && bar) {\n            const getDescription = list => list.find(n => n.class === 'android.view.View' && n.clickable === 'true' &&\n              n.bounds[2] - n.bounds[0] > visual.width * .5 && n.bounds[3] > visual.height * .7);\n            let description = getDescription(nodes);\n            const descriptionCollapsed = description && description.bounds[3] - description.bounds[1] < visual.width * .15;\n            if (description && (reelExpandedCaption || descriptionCollapsed || liteCaptionOverlapsTime(nodes, description))) {\n              reelExpandedCaption = true;\n              if (descriptionCollapsed) {\n                await navigate(description);\n                await wait(500);\n                nodes = await screen('reel-description-expanded');\n                description = getDescription(nodes);\n                bar = toolbar(nodes);\n                if (!description || !bar) { await wait(500); continue; }\n              }\n            }\n            const captionVisual = description ? await recognize('reel-caption', description.bounds) : visual;\n            const caption = liteReelCaption(captionVisual, description);\n            if (caption.replace(/[^a-z0-9]/g, '').length < 12) { await wait(500); continue; }\n            if (!reelDescription) reelDescription = caption;\n            result.reelCaption = { initial: reelDescription, current: caption };\n            if (!sameLiteCaption(reelDescription, caption)) throw new Error('La descripcion del reel cambio.');\n          }\n          if (bar) return { nodes, bar, visual, visualText: postVisualText };\n          await scrollPost(nodes);\n        }\n      }\n      await wait(1000);\n    }\n    throw new Error('No se identifico la publicacion y su barra de acciones en Lite.');\n  }\n  async function isLiked(bar) {\n    if (bar.like.selected === 'true' || bar.like.checked === 'true' || /^(ya no me gusta|unlike)$/.test(bar.like.label)) return true;\n    const shot = await photo('like-state');\n    const b = bar.like.bounds;\n    const size = shot.image.getSize();\n    if (b[0] < 0 || b[1] < 0 || b[2] > size.width || b[3] > size.height) throw new Error('Captura y XML no coinciden.');\n    // Electron crop() applies host scaling. XML coordinates use Android pixels.\n    const pixels = shot.image.toBitmap({ scaleFactor: 1 });\n    if (pixels.length !== size.width * size.height * 4) throw new Error('Escala de captura incompatible.');\n    let blue = 0;\n    for (let y = b[1]; y < b[3]; y++) for (let x = b[0]; x < b[2]; x++) {\n      const i = (y * size.width + x) * 4;\n      if (pixels[i] > 190 && pixels[i + 2] < 70 && pixels[i + 1] > 70 && pixels[i + 1] < 190) blue++;\n    }\n    result.likeState = { bounds: b, blueFraction: blue / areaOf(bar.like) };\n    save();\n    return blue / areaOf(bar.like) > .025;\n  }\n  function countIn(visual, node) {\n    const b = node.bounds;\n    const texts = visual.lines.filter(l => l.x >= b[0] && l.x + l.width <= b[2] + 3 && l.y >= b[1] && l.y < b[3])\n      .map(l => l.text.replace(/[^0-9]/g, '')).filter(Boolean);\n    return texts.length === 1 ? Number(texts[0]) : null;\n  }\n  async function resetToast() { if (toastEnabled) await rpc('clearLastToast', []); }\n  async function toast() { return toastEnabled ? String(await rpc('getLastToast', [15000]) || '') : ''; }\n  async function confirm(action, beforeCount, liveMode = false) {\n    let visibleChecks = 0;\n    for (let i = 0; i < 12; i++) {\n      await wait(700);\n      const message = normalizeLiteText(await toast());\n      if (/error|no se pudo|no puedes|intenta.*nuevo/.test(message)) throw new Error('Facebook rechazo ' + action + ': ' + message);\n      const nodes = await screen(action + '-check');\n      const edit = editor(nodes);\n      const clear = !edit || !edit.text || /^(Escribe|Write|Agrega|Add)/i.test(edit.text);\n      const sent = action === 'comment' ? liteSelectors.commentConfirmed : liteSelectors.shareConfirmed;\n      if (sent.test(message) && clear) return 'confirmado: ' + message;\n      if (i % 2 === 0) {\n        const visual = await recognize(action + '-confirmation');\n        if (!liveMode && visual.lines.some(l => sent.test(l.label)) && clear) return 'confirmado en pantalla';\n        if (visual.lines.some(l => /publicando|enviando|posting|sending/.test(l.label))) continue;\n        if (action === 'comment' && clear) {\n          const keys = liteCommentKeys(visual, edit, normalizeLiteText(v.commentText));\n          result.commentVerification = { before: commentKeysBefore, after: keys };\n          if (keys.some(key => !commentKeysBefore.includes(key))) visibleChecks++;\n          else visibleChecks = 0;\n          if (visibleChecks >= 2) return 'nuevo comentario visible en dos comprobaciones';\n          // Live opens a post detail view where the video hides recent comments.\n          // Hide the keyboard and scroll only after the single send attempt.\n          if (liveMode && keys.length === 0 && (i === 0 || i === 2)) {\n            await scrollPost(edit ? await dismissKeyboard(nodes) : nodes);\n            result.commentRevealScrolls = (result.commentRevealScrolls || 0) + 1;\n          } else if (i === 0 && !reel && !liveMode && edit && keys.length === 0) {\n            // On long posts the new first comment can be hidden under the fixed editor.\n            await scrollPost(nodes, true);\n            result.commentRevealed = true;\n          }\n        }\n        const bar = liveMode ? liteLiveToolbar(nodes) : toolbar(nodes);\n        if (bar && beforeCount !== null && clear) {\n          const after = countIn(visual, bar[action]);\n          if (after !== null && after > beforeCount) return 'contador ' + beforeCount + ' -> ' + after;\n        }\n      }\n    }\n    throw new Error('Envio pendiente de confirmar: ' + action + '. Revisar la publicacion antes de repetir.');\n  }\n\n  async function locateLive(seconds, optional = false) {\n    const end = Date.now() + seconds * 1000;\n    let sawMarker = false;\n    let feedOpened = false;\n    let nextFeedProbe = 0;\n    while (Date.now() < end) {\n      const nodes = await screen('live');\n      const bar = liteLiveToolbar(nodes);\n      if (bar) {\n        const visual = await recognize('live-identify');\n        const marker = visual.lines.find(line => /^(?:directo|l?ive)(?:\\s|$)/.test(line.label));\n        if (marker || visual.liveBadge) {\n          sawMarker = true;\n          const markerBottom = marker ? marker.y + marker.height : visual.height * .07;\n          const title = visual.lines.filter(line => line.y > markerBottom && line.y < visual.height * .22 &&\n            line.x < visual.width * .72 && line.label.length >= 3 && !/^(seguir|follow|\\d+)$/.test(line.label))\n            .sort((a, b) => b.width - a.width)[0];\n          if (!title || (targetText && !liteLiveUserMatches(title.label, targetText))) {\n            await wait(600);\n            continue;\n          }\n          if (!liveIdentity) liveIdentity = title.label;\n          return { nodes, bar, visual };\n        }\n      }\n      if (!bar && !feedOpened && targetText && Date.now() >= nextFeedProbe) {\n        nextFeedProbe = Date.now() + 2500;\n        const video = liteLiveFeedVideo(nodes);\n        if (video) {\n          const visual = await recognize('live-identify-feed');\n          const visible = normalizeLiteText(visual.lines.map(line => line.label).join(' '));\n          const marker = visual.lines.some(line => /^(?:directo|l?ive)(?:\\s|$)/.test(line.label));\n          const announced = /\\b(?:esta transmitiendo en (?:vivo|directo)|is live now|is live)\\b/.test(visible);\n          const feedUser = liteLiveFeedUser(visual.lines);\n          if ((marker || visual.liveBadge) && announced && liteLiveUserMatches(feedUser, targetText)) {\n            feedOpened = true;\n            await navigate(video);\n            await wait(1000);\n            continue;\n          }\n        }\n      }\n      await wait(700);\n    }\n    if (optional && !sawMarker) return null;\n    throw new Error(targetText && sawMarker ? 'El usuario visible del Live no coincide con targetText.' : 'No se identificaron los controles del Live de Facebook.');\n  }\n  async function runLive(live) {\n    result.kind = 'live';\n    result.identity = liveIdentity || 'directo';\n    if (targetText) result.targetText = targetText;\n    report('Live identificado en Facebook Lite: ' + result.identity);\n    if (actions.like) {\n      const before = countIn(live.visual, live.bar.like);\n      const liked = await isLiked(live.bar);\n      if (diagnostic) result.actions.like = 'diagnostico: control localizado; ' + (liked ? 'ya activo' : 'inactivo') + '; sin tocar';\n      else if (liked) result.actions.like = 'ya activo; conservado';\n      else {\n        result.actions.like = 'pending'; save();\n        await tap(live.bar.like);\n        let confirmed = false;\n        for (let i = 0; i < 10; i++) {\n          await wait(700);\n          const nodes = await screen('live-like-after');\n          const bar = liteLiveToolbar(nodes);\n          if (!bar) continue;\n          if (await isLiked(bar)) { confirmed = true; break; }\n          if (i % 2 === 1 && before !== null) {\n            const visual = await recognize('live-like-count');\n            const after = countIn(visual, bar.like);\n            if (after !== null && after > before) { confirmed = true; break; }\n          }\n        }\n        if (!confirmed) throw new Error('Envio pendiente de confirmar: Me gusta Live. No se repetira.');\n        result.actions.like = 'activado y verificado';\n      }\n      report('Like Live: ' + result.actions.like);\n    }\n    if (actions.share) {\n      live = await locateLive(20);\n      const before = countIn(live.visual, live.bar.share);\n      await navigate(live.bar.share);\n      const shareLabel = liteSelectors.shareSubmit;\n      let nodes, send, legacy = false, audienceConfirmed = false;\n      for (let i = 0; i < 20; i++) {\n        await wait(700);\n        nodes = await screen('live-share-sheet');\n        send = named(nodes, shareLabel);\n        audienceConfirmed = nodes.filter(n => n.clickable === 'true' && liteSelectors.publicAudience.test(n.label)).length === 1;\n        if (send && audienceConfirmed) break;\n        if (i % 2 === 1) {\n          const visual = await recognize('live-share-layout');\n          const liveEntry = !legacy && liteLiveShareEntry(nodes, visual);\n          if (liveEntry) { legacy = true; await navigate(liveEntry); continue; }\n          const liveComposer = liteLiveShareComposer(nodes, visual);\n          if (liveComposer) { send = liveComposer; audienceConfirmed = true; legacy = true; break; }\n          const entry = !legacy && liteShareMenuEntry(nodes, visual);\n          if (entry) { legacy = true; await navigate(entry); }\n        }\n      }\n      if (!send) throw new Error('No aparece el boton final para compartir el Live en el perfil.');\n      if (!audienceConfirmed) throw new Error('Configura manualmente la audiencia en Publico; no se compartio el Live.');\n      await photo('live-share-ready');\n      if (diagnostic) {\n        let closed = false;\n        for (let i = 0; i < 3; i++) {\n          await rpc('pressKey', ['back']);\n          await wait(600);\n          if (liteLiveToolbar(await screen('live-share-diagnostic-closed'))) { closed = true; break; }\n        }\n        if (!closed) throw new Error('No se cerro el compositor de compartir el Live.');\n        result.actions.share = 'diagnostico: compositor publico y boton final verificados; cerrado sin publicar';\n      } else {\n        await resetToast();\n        nodes = await screen('live-share-recheck');\n        const visual = legacy ? await recognize('live-share-recheck') : null;\n        send = legacy ? liteLiveShareComposer(nodes, visual) : named(nodes, shareLabel);\n        audienceConfirmed = legacy ? Boolean(send) : nodes.filter(n => n.clickable === 'true' && liteSelectors.publicAudience.test(n.label)).length === 1;\n        if (!send || !audienceConfirmed) throw new Error('La audiencia publica no se pudo reconfirmar; no se compartio el Live.');\n        result.actions.share = 'pending'; save();\n        await tap(send);\n        result.actions.share = await confirm('share', before, true);\n      }\n      live = await locateLive(20);\n      report('Compartir Live: ' + result.actions.share);\n    }\n    if (actions.comment) {\n      live = await locateLive(20);\n      const before = countIn(live.visual, live.bar.comment);\n      await navigate(live.bar.comment);\n      let nodes, edit;\n      for (let i = 0; i < 16 && !edit; i++) {\n        await wait(i === 0 ? 1000 : 600);\n        nodes = await screen('live-comment-open');\n        edit = editor(nodes);\n      }\n      if (!edit) throw new Error('Editor de comentarios Live ausente.');\n      if (edit.text && !/^(Escribe|Write|Agrega|Add)/i.test(edit.text)) throw new Error('Existe un borrador previo; se conserva sin reemplazarlo.');\n      const beforeVisual = await recognize('live-comment-before');\n      commentKeysBefore = liteCommentKeys(beforeVisual, edit, normalizeLiteText(v.commentText));\n      result.commentText = String(v.commentText).trim();\n      result.commentVerification = { before: commentKeysBefore, after: [] };\n      await rpc('setText', [{ mask: 16, className: edit.class }, String(v.commentText).trim()]);\n      await wait(500);\n      nodes = await dismissKeyboard(await screen('live-comment-draft'));\n      edit = editor(nodes);\n      if (!edit || edit.text !== String(v.commentText).trim()) throw new Error('El texto escrito no coincide con el comentario Live.');\n      const send = named(nodes, /^(enviar|publicar|send|post)$/) || liteSendButton(nodes, edit);\n      if (!send) throw new Error('Boton Enviar Live ausente o ambiguo.');\n      if (diagnostic) {\n        await photo('live-comment-diagnostic-ready');\n        await rpc('setText', [{ mask: 16, className: edit.class }, '']);\n        await wait(300);\n        const cleared = editor(await dismissKeyboard(await screen('live-comment-diagnostic-cleared')));\n        if (!cleared || (cleared.text && !/^(Escribe|Write|Agrega|Add)/i.test(cleared.text))) throw new Error('No se confirmo la limpieza del borrador Live.');\n        result.actions.comment = 'diagnostico: texto y boton Enviar verificados; borrador retirado sin publicar';\n      } else {\n        await resetToast();\n        result.actions.comment = 'pending'; save();\n        await tap(send);\n        result.actions.comment = await confirm('comment', before, true);\n      }\n      await rpc('pressKey', ['back']);\n      await wait(600);\n      live = await locateLive(20);\n      report('Comentario Live: ' + result.actions.comment);\n    }\n    await photo('final-live');\n    result.status = 'success';\n    v.fb_summary = Object.entries(result.actions).map(([action, detail]) => action + ': ' + detail).join('; ');\n    save();\n  }\n\n  try {\n    if (actions.comment && (!String(v.commentText || '').trim() || String(v.commentText).length > 500)) {\n      throw new Error('El comentario debe tener entre 1 y 500 caracteres.');\n    }\n    try { await rpc('setToastListener', [true]); toastEnabled = true; } catch (_) { /* Use visual confirmation. */ }\n    if (liveUrl) {\n      const live = await locateLive(12, true);\n      if (live) { await runLive(live); return; }\n    }\n    let post = await locatePost();\n    if (targetText) {\n      const visible = normalizeLiteText([identity, reelDescription, post.visualText || post.visual.lines.map(line => line.label).join(' ')].join(' '));\n      if (!liteTargetMatches(visible, targetText)) throw new Error('El texto visible no coincide con targetText.');\n      result.targetText = targetText;\n    }\n    result.identity = identity;\n    report('Publicacion identificada en Facebook Lite: ' + identity);\n    if (actions.like) {\n      if (diagnostic) result.actions.like = 'diagnostico: control localizado; ' + (await isLiked(post.bar) ? 'ya activo' : 'inactivo') + '; sin tocar';\n      else if (await isLiked(post.bar)) result.actions.like = 'ya activo; conservado';\n      else {\n        await tap(post.bar.like);\n        let confirmed = false;\n        for (let i = 0; i < 10; i++) {\n          await wait(900);\n          const bar = toolbar(await screen('like-after'));\n          if (bar && await isLiked(bar)) { confirmed = true; break; }\n        }\n        if (!confirmed) throw new Error('No se confirmo el estado Me gusta.');\n        result.actions.like = 'activado y verificado';\n      }\n      report('Like: ' + result.actions.like);\n    }\n    if (actions.share) {\n      post = await locatePost();\n      const before = countIn(post.visual, post.bar.share);\n      await navigate(post.bar.share);\n      const shareLabel = liteSelectors.shareSubmit;\n      let nodes, send, legacy = false, audienceConfirmed = false;\n      for (let i = 0; i < 20; i++) {\n        await wait(700);\n        nodes = await screen('share-sheet');\n        send = named(nodes, shareLabel);\n        audienceConfirmed = nodes.filter(n => n.clickable === 'true' && liteSelectors.publicAudience.test(n.label)).length === 1;\n        if (send && audienceConfirmed) break;\n        if (i % 2 === 1) {\n          const visual = await recognize('share-layout');\n          const composer = liteShareComposer(nodes, visual);\n          if (composer && audienceConfirmed) { send = composer; audienceConfirmed = true; legacy = true; break; }\n          const entry = !legacy && liteShareMenuEntry(nodes, visual);\n          if (entry) {\n            legacy = true;\n            result.shareLayout = 'menu Publicar -> Compartir en Facebook';\n            await navigate(entry);\n          }\n        }\n      }\n      if (!send) throw new Error('No aparece el boton final para compartir en el perfil.');\n      if (!audienceConfirmed) throw new Error('Configura manualmente la audiencia en Publico; no se compartio.');\n      await photo('share-ready');\n      if (diagnostic) {\n        let closed = false;\n        for (let i = 0; i < 3; i++) {\n          await rpc('pressKey', ['back']);\n          await wait(600);\n          const remaining = await screen('share-diagnostic-closed');\n          if (named(remaining, shareLabel)) continue;\n          if (legacy) {\n            const visual = await recognize('share-diagnostic-closed');\n            if (visual.lines.some(l => /^(compartir en|compartir en facebook|share on facebook)$/.test(l.label))) continue;\n          }\n          closed = true;\n          break;\n        }\n        if (!closed) throw new Error('No se cerro el compositor de compartir.');\n        result.actions.share = 'diagnostico: compositor y boton final verificados; cerrado sin publicar';\n      } else {\n        await resetToast();\n        nodes = await screen('share-recheck');\n        const recheckVisual = legacy ? await recognize('share-recheck') : null;\n        send = legacy ? liteShareComposer(nodes, recheckVisual) : named(nodes, shareLabel);\n        audienceConfirmed = nodes.filter(n => n.clickable === 'true' && liteSelectors.publicAudience.test(n.label)).length === 1;\n        if (!send || !audienceConfirmed) throw new Error('La audiencia publica no se pudo reconfirmar; no se compartio.');\n        result.actions.share = 'pending'; save();\n        await tap(send);\n        result.actions.share = await confirm('share', before);\n      }\n      report('Compartir: ' + result.actions.share);\n    }\n    if (actions.comment) {\n      post = await locatePost();\n      const before = countIn(post.visual, post.bar.comment);\n      let nodes = post.nodes;\n      if (!editor(nodes)) {\n        await navigate(post.bar.comment);\n        await wait(1000);\n        nodes = await screen('comment-open');\n      }\n      let edit = editor(nodes);\n      if (!edit) throw new Error('Editor de comentarios Lite ausente.');\n      if (diagnostic && edit.text && !/^(Escribe|Write|Agrega|Add)/i.test(edit.text)) {\n        throw new Error('Existe un borrador previo; se conserva sin reemplazarlo.');\n      }\n      const beforeVisual = await recognize('comment-before');\n      commentKeysBefore = liteCommentKeys(beforeVisual, edit, normalizeLiteText(v.commentText));\n      result.commentText = String(v.commentText).trim();\n      result.commentVerification = { before: commentKeysBefore, after: [] };\n      await rpc('setText', [{ mask: 16, className: edit.class }, String(v.commentText).trim()]);\n      await wait(500);\n      nodes = await screen('comment-draft');\n      nodes = await dismissKeyboard(nodes);\n      edit = editor(nodes);\n      if (!edit || edit.text !== String(v.commentText).trim()) throw new Error('El texto escrito no coincide con el comentario.');\n      const send = named(nodes, /^(enviar|publicar|send|post)$/) || liteSendButton(nodes, edit);\n      if (!send) throw new Error('Boton Enviar ausente o ambiguo.');\n      if (diagnostic) {\n        await photo('comment-diagnostic-ready');\n        await rpc('setText', [{ mask: 16, className: edit.class }, '']);\n        await wait(300);\n        const cleared = editor(await dismissKeyboard(await screen('comment-diagnostic-cleared')));\n        if (!cleared || (cleared.text && !/^(Escribe|Write|Agrega|Add)/i.test(cleared.text))) {\n          throw new Error('No se confirmo la limpieza del borrador de diagnostico.');\n        }\n        result.actions.comment = 'diagnostico: texto y boton Enviar verificados; borrador retirado sin publicar';\n      } else {\n        await resetToast();\n        result.actions.comment = 'pending'; save();\n        await tap(send);\n        result.actions.comment = await confirm('comment', before);\n      }\n      report('Comentario: ' + result.actions.comment);\n      if (reel) { await rpc('pressKey', ['back']); await wait(600); }\n    }\n    await locatePost();\n    await photo('final-post');\n    result.status = 'success';\n    v.fb_summary = Object.entries(result.actions).map(([action, detail]) => action + ': ' + detail).join('; ');\n    save();\n  } catch (error) {\n    result.status = 'failed'; result.error = error.message;\n    v.fb_error = error.message;\n    save();\n    try { await photo('error'); } catch (_) { /* Preserve original failure. */ }\n    // Avoid infrastructure-keyword retries replaying the complete node after a send.\n    throw new Error('FB_LITE_ERROR: consultar fb_error y result.json.');\n  } finally {\n    if (toastEnabled && !ctx.actionProcessed) {\n      try { await ui.callRpc('setToastListener', [false], 4000, 5); } catch (_) { /* No further UI actions. */ }\n    }\n  }\n}\n\nfunction normalizeLiteText(value) {\n  return String(value || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/\\s+/g, ' ').trim().toLowerCase();\n}\nfunction liteTargetMatches(visible, target) {\n  visible = normalizeLiteText(visible);\n  target = normalizeLiteText(target);\n  if (!visible || !target) return false;\n  if (visible.includes(target)) return true;\n  const words = text => text.replace(/[^a-z0-9]+/g, ' ').trim().split(' ').filter(Boolean);\n  const targetHead = words(target).filter(word => word.length >= 4).slice(0, 8);\n  const visibleWords = words(visible);\n  if (!targetHead.length || !visibleWords.length) return false;\n  const near = (a, b) => {\n    if (Math.abs(a.length - b.length) > 2) return false;\n    const row = Array.from({ length: b.length + 1 }, (_, i) => i);\n    for (let i = 1; i <= a.length; i++) {\n      let diagonal = row[0]; row[0] = i;\n      for (let j = 1; j <= b.length; j++) {\n        const old = row[j];\n        row[j] = Math.min(row[j] + 1, row[j - 1] + 1, diagonal + (a[i - 1] === b[j - 1] ? 0 : 1));\n        diagonal = old;\n      }\n    }\n    return row[b.length] <= Math.max(1, Math.floor(Math.max(a.length, b.length) * .34));\n  };\n  let cursor = 0, matched = 0;\n  for (const expected of targetHead) {\n    const offset = visibleWords.slice(cursor).findIndex(candidate => near(expected, candidate));\n    if (offset >= 0) { cursor += offset + 1; matched++; }\n  }\n  return matched >= Math.min(4, targetHead.length) && matched >= targetHead.length / 2;\n}\nfunction liteLiveUserMatches(user, target) {\n  const words = value => normalizeLiteText(value).split(/\\s+/).filter(word => word.length >= 4);\n  const expected = words(target).slice(0, 2);\n  const visible = words(user).slice(0, 2);\n  return expected.length === 2 && visible.length === 2 && liteTargetMatches(visible.join(' '), expected.join(' '));\n}\n\nfunction liteLiveFeedUser(lines) {\n  const announcement = lines.map(line => normalizeLiteText(line.label)).find(label => /\\b(?:esta transmitiendo en|is live)\\b/.test(label));\n  return announcement ? announcement.replace(/\\s+(?:esta transmitiendo en|is live).*$/, '') : '';\n}\nfunction parseLiteXml(xml) {\n  if (typeof xml !== 'string' || !xml.includes('<hierarchy') || !xml.includes('</hierarchy>') || xml.length > 3000000 || xml.includes('\\0')) {\n    throw new Error('Jerarquia XML vacia o corrupta.');\n  }\n  const decode = value => value.replace(/&(#x[0-9a-f]+|#\\d+|amp|lt|gt|quot|apos);/gi, (all, entity) => {\n    if (entity[0] === '#') return String.fromCodePoint(entity[1].toLowerCase() === 'x' ? parseInt(entity.slice(2), 16) : Number(entity.slice(1)));\n    return { amp: '&', lt: '<', gt: '>', quot: '\"', apos: \"'\" }[entity];\n  });\n  const nodes = [];\n  for (const tag of xml.match(/<node\\b[^>]*>/g) || []) {\n    const n = {};\n    for (const attr of tag.matchAll(/([\\w-]+)\\s*=\\s*([\"'])(.*?)\\2/g)) n[attr[1]] = decode(attr[3]);\n    const b = (n.bounds || '').match(/^\\[(-?\\d+),(-?\\d+)\\]\\[(-?\\d+),(-?\\d+)\\]$/);\n    if (!b) continue;\n    n.bounds = b.slice(1).map(Number);\n    n.label = normalizeLiteText(n['content-desc'] || n.text);\n    n.visible = n['visible-to-user'];\n    n.hasChildren = !/\\/\\s*>$/.test(tag);\n    nodes.push(n);\n  }\n  return nodes;\n}\nfunction areaOf(n) { return (n.bounds[2] - n.bounds[0]) * (n.bounds[3] - n.bounds[1]); }\nfunction liteCommentKeys(visual, edit, text) {\n  return visual.lines.filter(l => l.label === text && (!edit || l.y + l.height < edit.bounds[1])).map(line => {\n    const author = visual.lines.filter(l => l.y < line.y && line.y - l.y < line.height * 2.5 &&\n      Math.abs(l.x - line.x) < visual.width * .06).sort((a, b) => b.y - a.y)[0];\n    return (author ? author.label : '') + '|' + line.label;\n  });\n}\nfunction sameLiteCaption(a, b) {\n  // The ellipsis and adjacent \"más\" control are not part of the caption. OCR often\n  // merges their icon/text differently after returning from a sharing composer.\n  const clean = text => normalizeLiteText(text).replace(/(?:\\.{2,}|…).*$/, '').replace(/\\s+mas$/, '').replace(/[^a-z0-9]/g, '');\n  a = clean(a);\n  b = clean(b);\n  const row = Array.from({ length: b.length + 1 }, (_, i) => i);\n  for (let i = 1; i <= a.length; i++) {\n    let diagonal = row[0]; row[0] = i;\n    for (let j = 1; j <= b.length; j++) {\n      const old = row[j];\n      row[j] = Math.min(row[j] + 1, row[j - 1] + 1, diagonal + (a[i - 1] === b[j - 1] ? 0 : 1));\n      diagonal = old;\n    }\n  }\n  return Math.min(a.length, b.length) >= 12 && row[b.length] <= Math.max(a.length, b.length) * .25;\n}\nfunction liteReelCaption(visual, description) {\n  if (!description) return '';\n  const b = description.bounds;\n  // OCR can merge letters with the video background and extend above the XML text box.\n  return visual.lines.filter(l => l.y + l.height / 2 >= b[1] - 5 &&\n    l.y + l.height / 2 < b[3] && l.x + (l.width || 0) >= b[0] - 5 && l.x < Math.min(b[2], visual.width * .75))\n    .sort((a, c) => Math.abs(a.y - c.y) > Math.min(a.height, c.height) * .5 ? a.y - c.y : a.x - c.x)\n    .map(l => l.label).join(' ').slice(0, 80);\n}\nfunction liteCaptionOverlapsTime(nodes, description) {\n  const b = description.bounds;\n  return nodes.some(n => n.class === 'android.widget.TextView' && /^\\s*(?:\\/\\s*)?\\d+:\\d+/.test(n.text || '') &&\n    n.bounds[0] < b[2] && n.bounds[2] > b[0] && n.bounds[1] < b[3] && n.bounds[3] > b[1]);\n}\nfunction liteCaptionMask(bitmap) {\n  // White caption glyphs are stable; the moving video background is not. Render\n  // only near-white neutral pixels as dark ink before OCR on the caption region.\n  for (let i = 0; i < bitmap.length; i += 4) {\n    const min = Math.min(bitmap[i], bitmap[i + 1], bitmap[i + 2]);\n    const max = Math.max(bitmap[i], bitmap[i + 1], bitmap[i + 2]);\n    const value = min > 235 && max - min < 20 ? 0 : 255;\n    bitmap[i] = value; bitmap[i + 1] = value; bitmap[i + 2] = value; bitmap[i + 3] = 255;\n  }\n  return bitmap;\n}\nfunction liteReelLayout(nodes, bar) {\n  if (!bar || !nodes.some(n => n['resource-id'] === 'com.facebook.lite:id/video_view')) return false;\n  const width = Math.max(...nodes.map(n => n.bounds[2]));\n  return [bar.like, bar.comment, bar.share].every(n => n.bounds[0] > width * .78) &&\n    bar.like.bounds[3] <= bar.comment.bounds[1] && bar.comment.bounds[3] <= bar.share.bounds[1] &&\n    nodes.some(n => n['resource-id'] === 'com.facebook.lite:id/video_play_icon' && /^(play|reproducir)$/.test(n.label));\n}\nfunction liteVisualButton(nodes, line) {\n  if (!line) return null;\n  const x = line.x + line.width / 2, y = line.y + line.height / 2;\n  const candidates = nodes.filter(n => n.clickable === 'true' && n.enabled !== 'false' &&\n    n.bounds[0] <= x && n.bounds[2] >= x && n.bounds[1] <= y && n.bounds[3] >= y)\n    .sort((a, b) => areaOf(a) - areaOf(b));\n  return candidates[0] || null;\n}\nfunction liteLiveShareEntry(nodes, visual) {\n  const entries = visual.lines.filter(line => /^(escribir una(?: publicacion)?|write a post)$/.test(line.label) &&\n    (/publicacion$/.test(line.label) || visual.lines.some(next => next.label === 'publicacion' &&\n      Math.abs(next.x - line.x) < visual.width * .08 && next.y > line.y && next.y - line.y < visual.height * .06)));\n  return entries.length === 1 ? liteVisualButton(nodes, entries[0]) : null;\n}\nfunction liteLiveShareComposer(nodes, visual) {\n  if (!visual || !visual.lines.some(line => line.label === 'compartir en facebook')) return null;\n  const audience = visual.lines.filter(line => /^(?:o)?compartir con: publico$|^share (?:with|to): public$/.test(line.label));\n  const entries = visual.lines.filter(line => /^(publicar|post)$/.test(line.label) && line.x > visual.width * .6 && line.y < visual.height * .2);\n  return audience.length === 1 && entries.length === 1 ? liteVisualButton(nodes, entries[0]) : null;\n}\nfunction liteShareMenuEntry(nodes, visual) {\n  if (!visual.lines.some(l => /^(compartir en|share to)$/.test(l.label)) ||\n      !visual.lines.some(l => /^(grupos|groups)$/.test(l.label))) return null;\n  const entries = visual.lines.filter(l => /^(publicar|post)$/.test(l.label));\n  return entries.length === 1 ? liteVisualButton(nodes, entries[0]) : null;\n}\nfunction liteShareComposer(nodes, visual) {\n  if (!visual.lines.some(l => /^(compartir en facebook|share on facebook)$/.test(l.label))) return null;\n  // This older composer exposes two equivalent PUBLICAR buttons; use its unique header button.\n  const entries = visual.lines.filter(l => /^(publicar|post)$/.test(l.label) && l.x > visual.width * .6 && l.y < visual.height * .2);\n  return entries.length === 1 ? liteVisualButton(nodes, entries[0]) : null;\n}\nfunction liteToolbar(nodes, reel) {\n  const width = Math.max(...nodes.map(n => n.bounds[2]));\n  const buttons = nodes.filter(n => n.clickable === 'true' && n.enabled !== 'false');\n  const labelled = [liteSelectors.toolbarLike, liteSelectors.toolbarComment, liteSelectors.toolbarShare]\n    .map(pattern => buttons.filter(n => pattern.test(n.label)));\n  if (labelled.every(matches => matches.length === 1)) return { like: labelled[0][0], comment: labelled[1][0], share: labelled[2][0] };\n  if (reel) {\n    const column = buttons.filter(n => n.bounds[0] > width * .78 && (n.bounds[2] - n.bounds[0]) > width * .1 &&\n      (n.bounds[3] - n.bounds[1]) > (n.bounds[2] - n.bounds[0]) * 1.05 &&\n      (n.bounds[3] - n.bounds[1]) < (n.bounds[2] - n.bounds[0]) * 1.6).sort((a, b) => a.bounds[1] - b.bounds[1]);\n    if (column.length !== 3) return null;\n    return { like: column[0], comment: column[1], share: column[2] };\n  }\n  const groups = new Map();\n  for (const n of buttons) {\n    const b = n.bounds;\n    if (b[2] - b[0] < width * .12 || b[2] - b[0] > width * .36 || b[3] - b[1] < width * .06 || b[3] - b[1] > width * .2) continue;\n    const key = b[1] + ':' + b[3];\n    if (!groups.has(key)) groups.set(key, []);\n    groups.get(key).push(n);\n  }\n  // Data-saving layout adds a clickable blank spacer and reaction badge on the right.\n  // Real action containers have icon/count children; the spacer has none.\n  const rows = [...groups.values()].map(row => row.length > 3 ? row.filter(n => n.hasChildren) : row)\n    .filter(row => row.length === 3 && row.every(n => n.hasChildren));\n  if (rows.length !== 1) return null;\n  const row = rows[0].sort((a, b) => a.bounds[0] - b.bounds[0]);\n  if (row[0].bounds[0] > width * .05 || row[2].bounds[2] < width * .52) return null;\n  return { like: row[0], comment: row[1], share: row[2] };\n}\nfunction liteLiveBadge(image) {\n  const size = image.getSize();\n  const pixels = image.toBitmap({ scaleFactor: 1 });\n  if (pixels.length !== size.width * size.height * 4) return false;\n  let red = 0;\n  const right = Math.floor(size.width * .5), bottom = Math.floor(size.height * .25);\n  for (let y = Math.floor(size.height * .025); y < bottom; y++) for (let x = 0; x < right; x++) {\n    const i = (y * size.width + x) * 4;\n    if (pixels[i + 2] > 180 && pixels[i + 1] < 105 && pixels[i] < 125) red++;\n  }\n  return red > size.width * 4;\n}\nfunction liteLiveFeedVideo(nodes) {\n  const width = Math.max(...nodes.map(n => n.bounds[2]));\n  const page = nodes.find(n => String(n['resource-id'] || '').endsWith(':id/main_layout'));\n  const height = page ? page.bounds[3] : Math.max(...nodes.map(n => n.bounds[3]));\n  const videos = nodes.filter(n => n['resource-id'] === 'com.facebook.lite:id/video_view' &&\n    n.bounds[1] > height * .25 && n.bounds[2] - n.bounds[0] > width * .8 && n.bounds[3] - n.bounds[1] > height * .3);\n  return videos.length === 1 ? videos[0] : null;\n}\nfunction liteLiveToolbar(nodes) {\n  if (!nodes.some(n => n['resource-id'] === 'com.facebook.lite:id/video_view')) return null;\n  const width = Math.max(...nodes.map(n => n.bounds[2]));\n  const page = nodes.find(n => String(n['resource-id'] || '').endsWith(':id/main_layout'));\n  const height = page ? page.bounds[3] : Math.max(...nodes.filter(n => n['resource-id'] !== 'android:id/navigationBarBackground').map(n => n.bounds[3]));\n  const groups = new Map();\n  for (const n of nodes.filter(n => n.class === 'android.view.ViewGroup' && n.clickable === 'true' && n.enabled !== 'false' && n.hasChildren)) {\n    const b = n.bounds, w = b[2] - b[0], h = b[3] - b[1];\n    if (b[1] < height * .88 || w < width * .25 || w > width * .4 || h < width * .05 || h > width * .16) continue;\n    const key = b[1] + ':' + b[3];\n    if (!groups.has(key)) groups.set(key, []);\n    groups.get(key).push(n);\n  }\n  const rows = [...groups.values()].filter(row => row.length === 3);\n  if (rows.length !== 1) return null;\n  const row = rows[0].sort((a, b) => a.bounds[0] - b.bounds[0]);\n  const gap = width * .03;\n  if (row[0].bounds[0] > gap || row[2].bounds[2] < width - gap || row[1].bounds[0] - row[0].bounds[2] > gap || row[2].bounds[0] - row[1].bounds[2] > gap) return null;\n  return { like: row[0], comment: row[1], share: row[2] };\n}\nfunction liteSendButton(nodes, edit) {\n  const b = edit.bounds;\n  const matches = nodes.filter(n => n.clickable === 'true' && n.enabled !== 'false' && n.bounds[0] >= b[2] &&\n    n.bounds[1] < b[3] && n.bounds[3] > b[1] && n.bounds[3] - n.bounds[1] > 20 &&\n    Math.abs((n.bounds[1] + n.bounds[3] - b[1] - b[3]) / 2) < (b[3] - b[1]) * .3);\n  return matches.length === 1 ? matches[0] : null;\n}\n\n\nawait facebookLiteUI(this, \"$ImagePath = [Console]::In.ReadToEnd()\\n$ErrorActionPreference = 'Stop'\\n[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false)\\nAdd-Type -AssemblyName System.Runtime.WindowsRuntime\\n$null = [Windows.Storage.StorageFile, Windows.Storage, ContentType=WindowsRuntime]\\n$null = [Windows.Storage.Streams.IRandomAccessStream, Windows.Storage.Streams, ContentType=WindowsRuntime]\\n$null = [Windows.Graphics.Imaging.BitmapDecoder, Windows.Graphics.Imaging, ContentType=WindowsRuntime]\\n$null = [Windows.Graphics.Imaging.SoftwareBitmap, Windows.Graphics.Imaging, ContentType=WindowsRuntime]\\n$null = [Windows.Media.Ocr.OcrEngine, Windows.Foundation, ContentType=WindowsRuntime]\\n$null = [Windows.Media.Ocr.OcrResult, Windows.Foundation, ContentType=WindowsRuntime]\\n$asTask = [System.WindowsRuntimeSystemExtensions].GetMethods() | Where-Object {\\n    $_.Name -eq 'AsTask' -and $_.IsGenericMethod -and $_.GetParameters().Count -eq 1 -and\\n    $_.GetParameters()[0].ParameterType.Name -eq 'IAsyncOperation`1'\\n}\\nfunction Wait-WinRT($Operation, [Type]$Type) {\\n    $task = $asTask.MakeGenericMethod($Type).Invoke($null, @($Operation))\\n    if (-not $task.Wait(20000)) { throw 'Windows OCR timed out' }\\n    return $task.Result\\n}\\n$file = Wait-WinRT ([Windows.Storage.StorageFile]::GetFileFromPathAsync($ImagePath)) ([Windows.Storage.StorageFile])\\n$stream = Wait-WinRT ($file.OpenAsync([Windows.Storage.FileAccessMode]::Read)) ([Windows.Storage.Streams.IRandomAccessStream])\\n$bitmap = $null\\ntry {\\n    $decoder = Wait-WinRT ([Windows.Graphics.Imaging.BitmapDecoder]::CreateAsync($stream)) ([Windows.Graphics.Imaging.BitmapDecoder])\\n    $bitmap = Wait-WinRT ($decoder.GetSoftwareBitmapAsync()) ([Windows.Graphics.Imaging.SoftwareBitmap])\\n    $engine = [Windows.Media.Ocr.OcrEngine]::TryCreateFromUserProfileLanguages()\\n    if ($null -eq $engine) { throw 'Install an OCR language in Windows Settings' }\\n    $result = Wait-WinRT ($engine.RecognizeAsync($bitmap)) ([Windows.Media.Ocr.OcrResult])\\n    $lines = @($result.Lines | ForEach-Object {\\n        $words = @($_.Words)\\n        $left = ($words | ForEach-Object { $_.BoundingRect.X } | Measure-Object -Minimum).Minimum\\n        $top = ($words | ForEach-Object { $_.BoundingRect.Y } | Measure-Object -Minimum).Minimum\\n        $right = ($words | ForEach-Object { $_.BoundingRect.X + $_.BoundingRect.Width } | Measure-Object -Maximum).Maximum\\n        $bottom = ($words | ForEach-Object { $_.BoundingRect.Y + $_.BoundingRect.Height } | Measure-Object -Maximum).Maximum\\n        [pscustomobject]@{text=$_.Text; x=$left; y=$top; width=($right-$left); height=($bottom-$top)}\\n    })\\n    [pscustomobject]@{language=$engine.RecognizerLanguage.LanguageTag; width=$bitmap.PixelWidth; height=$bitmap.PixelHeight; lines=$lines} | ConvertTo-Json -Depth 5 -Compress\\n} finally {\\n    if ($null -ne $bitmap) { $bitmap.Dispose() }\\n    $stream.Dispose()\\n}\\n\");\n"
