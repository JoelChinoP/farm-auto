  "script": {
    "id": "facebook-lite-open-actions-v2",
    "name": "📱 Facebook Lite · Abrir + Like + Compartir + Comentar v2.5.22",
    "description": "Flujo independiente para validar apertura y acciones de publicaciones, reels y lives en Facebook Lite.",
    "version": "2.5.22",
    "variables": [
      {
        "id": "content_url",
        "name": "contentUrl",
        "label": "Enlace de contenido",
        "value": "",
        "secret": false
      },
      {
        "id": "like",
        "name": "like",
        "label": "Dar Me gusta",
        "value": false,
        "secret": false
      },
      {
        "id": "comment",
        "name": "comment",
        "label": "Comentar",
        "value": false,
        "secret": false
      },
      {
        "id": "commentText",
        "name": "commentText",
        "label": "Comentario",
        "value": "",
        "secret": false
      },
      {
        "id": "share",
        "name": "share",
        "label": "Compartir ahora (publico)",
        "value": false,
        "secret": false
      },
      {
        "id": "targetText",
