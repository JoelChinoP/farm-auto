{
  "id": "",
  "userId": 0,
  "name": "📱 Facebook/TikTok · Abrir contenido",
  "description": "Enciende la pantalla, reinicia la aplicación seleccionada y abre publicaciones, videos o Live.",
  "logo": null,
  "version": "2.2.0",
  "input": [
    {
      "id": "input-content-url",
      "type": "input",
      "name": "Enlace de contenido",
      "options": {
        "variable": {
          "id": "content_url",
          "name": "contentUrl",
          "label": "Enlace de contenido",
          "value": "",
          "secret": false
        },
        "hideLabel": false,
        "value": "",
        "placeholder": "https://www.facebook.com/... o https://www.tiktok.com/...",
        "width": null,
        "height": null,
        "labelWidth": 160,
        "maxLength": 2048,
        "minLength": 10,
        "disabled": false,
        "showCount": false
      }
    },
    {
      "id": "select-package-name",
      "type": "select",
      "name": "Plataforma",
      "options": {
        "variable": {
          "id": "package_name",
          "name": "packageName",
          "label": "Plataforma",
          "value": "",
          "secret": false
        },
        "hideLabel": false,
        "value": null,
        "options": [
          {
            "label": "Facebook Lite",
            "value": "com.facebook.lite"
          },
          {
            "label": "TikTok",
            "value": "com.zhiliaoapp.musically"
          }
        ],
        "isMultiple": false,
        "placeholder": "Seleccione una plataforma",
        "width": null,
        "height": null,
        "labelWidth": 160
      }
    }
  ],
  "script": {
    "id": "control-panel-open-social-content",
    "name": "Control Panel - Abrir contenido social",
    "description": "Valida el enlace, enciende la pantalla y abre el contenido con navegación específica de Facebook y TikTok.",
    "version": "2.2.0",
    "variables": [
      {
        "id": "content_url",
        "name": "contentUrl",
        "label": "Enlace de contenido",
        "value": "",
        "secret": false
      },
      {
        "id": "package_name",
        "name": "packageName",
        "label": "Plataforma",
        "value": "",
        "secret": false
      },
      {
        "id": "contentUri",
        "name": "contentUri",
        "label": "URI de apertura",
        "value": "",
        "secret": false
      },
      {
        "id": "open_error",
        "name": "open_error",
        "label": "Error de apertura",
        "value": "No se pudo abrir el contenido en el dispositivo; consulta el registro del nodo.",
        "secret": false
      }
    ],
    "flow": {
      "nodes": [
        {
          "id": "social_start",
          "type": "input",
          "position": {
            "x": 80,
            "y": 180
          },
          "data": {
            "action": "Start",
            "options": {},
            "successNode": "social_validate",
            "failNode": null
          },
          "label": "Start",
          "sourcePosition": "right",
          "targetPosition": "left",
          "deletable": false,
          "class": ""
        },
        {
          "id": "social_validate",
          "type": "custom",
          "position": {
            "x": 80,
            "y": 400
          },
          "data": {
            "icon": "code",
            "action": "Javascript",
            "options": {
              "script": "const v = this.variables;\nv.open_error = 'No se pudo abrir el contenido en el dispositivo; consulta el registro del nodo.';\nv.contentUri = '';\nconst raw = String(v.contentUrl || '').trim();\nconst facebook = v.packageName === 'com.facebook.lite';\nconst tiktok = v.packageName === 'com.zhiliaoapp.musically';\nlet parsed;\ntry { parsed = new URL(raw); } catch (_) { parsed = null; }\nconst host = parsed ? parsed.hostname.toLowerCase() : '';\nconst domain = facebook ? 'facebook.com' : 'tiktok.com';\nconst allowed = host === domain || host.endsWith('.' + domain) || (facebook && host === 'fb.watch');\nif ((!facebook && !tiktok) || !parsed || parsed.protocol !== 'https:' || !allowed ||\n    parsed.username || parsed.password || (parsed.port && parsed.port !== '443') ||\n    raw.length > 2048 || /['\"\\s\\x00-\\x1f\\x7f\\\\]/.test(raw)) {\n  v.open_error = 'Introduce un enlace HTTPS válido de la plataforma seleccionada, sin credenciales ni puertos alternativos.';\n  throw new Error('OPEN_INPUT_ERROR');\n}\nv.contentUrl = raw;\nconst video = tiktok && /^\\/@[^/]+\\/video\\/(\\d+)\\/?$/.exec(parsed.pathname);\nv.contentUri = video ? 'snssdk1233://aweme/detail/' + video[1] : raw;",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "30",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "social_wake",
            "failNode": "social_error"
          },
          "label": "Validar enlace y preparar URI",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_wake",
          "type": "custom",
          "position": {
            "x": 300,
            "y": 400
          },
          "data": {
            "icon": "terminal",
            "action": "Adb",
            "options": {
              "command": "input keyevent KEYCODE_WAKEUP",
              "outputVariable": null,
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "30",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "social_platform_facebook",
            "failNode": "social_error"
          },
          "label": "Preparar pantalla · Encender",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_platform_facebook",
          "type": "custom",
          "position": {
            "x": 300,
            "y": 180
          },
          "data": {
            "icon": "if",
            "action": "If",
            "options": {
              "leftOperand": "packageName",
              "operator": "=",
              "rightOperand": "com.facebook.lite",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "30",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "social_force_stop",
            "failNode": "social_platform_tiktok"
          },
          "label": "¿Facebook Lite?",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_platform_tiktok",
          "type": "custom",
          "position": {
            "x": 540,
            "y": 420
          },
          "data": {
            "icon": "if",
            "action": "If",
            "options": {
              "leftOperand": "packageName",
              "operator": "=",
              "rightOperand": "com.zhiliaoapp.musically",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "30",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "tiktok_force_stop",
            "failNode": "social_error"
          },
          "label": "¿TikTok?",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_force_stop",
          "type": "custom",
          "position": {
            "x": 540,
            "y": 40
          },
          "data": {
            "icon": "terminal",
            "action": "Adb",
            "options": {
              "command": "am force-stop com.facebook.lite",
              "outputVariable": null,
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "45",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "social_open_app",
            "failNode": "social_error"
          },
          "label": "Facebook Lite · Cerrar aplicación",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_open_app",
          "type": "custom",
          "position": {
            "x": 780,
            "y": 40
          },
          "data": {
            "icon": "play",
            "action": "StartApp",
            "options": {
              "packageName": "com.facebook.lite",
              "timeout": "45",
              "disabled": false,
              "nodeSleep": "3",
              "nodeTimeout": "60",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "social_content",
            "failNode": "social_error"
          },
          "label": "Facebook Lite · Abrir aplicación",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_content",
          "type": "custom",
          "position": {
            "x": 1020,
            "y": 40
          },
          "data": {
            "icon": "terminal",
            "action": "Adb",
            "options": {
              "command": "am start -W -a android.intent.action.VIEW -d '${contentUrl}' -p com.facebook.lite",
              "outputVariable": null,
              "disabled": false,
              "nodeSleep": "4",
              "nodeTimeout": "60",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "social_live_ready",
            "failNode": "social_error"
          },
          "label": "Facebook Lite · Abrir contenido",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_live_ready",
          "type": "custom",
          "position": {
            "x": 1020,
            "y": -280
          },
          "data": {
            "icon": "element-exists",
            "action": "ElementExists",
            "options": {
              "xpath": "//*[@package='com.facebook.lite' and (@class='androidx.recyclerview.widget.RecyclerView' or @resource-id='com.facebook.lite:id/video_view')]",
              "timeout": "45",
              "disabled": false,
              "nodeSleep": "2",
              "nodeTimeout": "55",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "social_live_detect",
            "failNode": "social_live_detect"
          },
          "label": "Facebook Lite · Esperar interfaz",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_live_detect",
          "type": "custom",
          "position": {
            "x": 1260,
            "y": -80
          },
          "data": {
            "icon": "image",
            "action": "Image",
            "options": {
              "inputBase64": "data:image/png;base64,",
              "action": "exists",
              "timeout": "8",
              "indexImage": "0",
              "clickDelay": "0",
              "threshold": "0.99",
              "rgb": "true",
              "matchingMethod": "tpl",
              "outputPositionsVariable": null,
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "20",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "social_live_open",
            "failNode": "social_live_detect_variant"
          },
          "label": "Facebook Lite · Detectar LIVE",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_live_detect_variant",
          "type": "custom",
          "position": {
            "x": 1260,
            "y": -280
          },
          "data": {
            "icon": "image",
            "action": "Image",
            "options": {
              "inputBase64": "data:image/png;base64,",
              "action": "exists",
              "timeout": "5",
              "indexImage": "0",
              "clickDelay": "0",
              "threshold": "0.99",
              "rgb": "true",
              "matchingMethod": "tpl",
              "outputPositionsVariable": null,
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "20",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "social_live_open",
            "failNode": "social_live_detect_vivo"
          },
          "label": "Facebook Lite · Detectar LIVE (variante)",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_live_detect_vivo",
          "type": "custom",
          "position": {
            "x": 1260,
            "y": -480
          },
          "data": {
            "icon": "image",
            "action": "Image",
            "options": {
              "inputBase64": "data:image/png;base64,",
              "action": "exists",
              "timeout": "5",
              "indexImage": "0",
              "clickDelay": "0",
              "threshold": "0.99",
              "rgb": "true",
              "matchingMethod": "tpl",
              "outputPositionsVariable": null,
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "20",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "social_live_open",
            "failNode": "social_success"
          },
          "label": "Facebook Lite · Detectar LIVE (En vivo)",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_live_open",
          "type": "custom",
          "position": {
            "x": 1500,
            "y": -80
          },
          "data": {
            "icon": "touch",
            "action": "Javascript",
            "options": {
              "script": "const app = \"(@package='com.facebook.lite' or @package='com.facebook.katana')\";\nconst video = \"//*[\" + app + \" and (@resource-id='com.facebook.lite:id/video_view' or @resource-id='com.facebook.katana:id/video_view')]\";\nconst inFeed = video + \"[ancestor::*[@class='androidx.recyclerview.widget.RecyclerView']]/ancestor::*[@clickable='true'][1]\";\nconst preview = \"//*[(\" + app.slice(1, -1) + \") and @class='androidx.recyclerview.widget.RecyclerView']/*/*[@clickable='true']/*[@class='android.view.ViewGroup' and @clickable='false']/*[@class='android.view.View' and @clickable='true'] | \" +\n  \"//*[(\" + app.slice(1, -1) + \") and @class='android.widget.Button' and (@content-desc='Detalles del video' or @content-desc='Video details')]\";\nconst player = video + \"[ancestor::*[@resource-id='com.facebook.lite:id/videoview' or @resource-id='com.facebook.katana:id/videoview']]\";\nlet clicked = false;\nlet stable = 0;\nlet lastError = '';\nfor (let check = 0; check < 15; check++) {\n  try {\n    const xml = await this.getXml();\n    if (await this.queryXpath(player, xml)) {\n      if (++stable >= 2) return;\n    } else {\n      stable = 0;\n      if (!clicked) {\n        const element = (await this.queryXpath('(' + inFeed + ')[1]', xml)) ||\n          (await this.queryXpath('(' + preview + ')[1]', xml));\n        if (element) {\n          clicked = true;\n          await element.click();\n        }\n      }\n    }\n    lastError = '';\n  } catch (error) {\n    stable = 0;\n    lastError = String(error && error.message || error);\n    if (!/HTTP 50[234]|status code 50[234]|ECONNRESET|ECONNREFUSED|ETIMEDOUT|socket hang up|timed out/i.test(lastError)) throw error;\n  }\n  await genfarmerSleep(1);\n}\nthrow new Error('No se pudo confirmar el reproductor LIVE tras la espera.' + (lastError ? ' ' + lastError : ''));",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "45",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "60",
              "nodeLog": ""
            },
            "successNode": "social_success",
            "failNode": "social_error"
          },
          "label": "Facebook Lite · Abrir video LIVE",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
