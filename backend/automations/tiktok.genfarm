              "script": "'use strict';\nconst fs = require('fs');\nconst path = require('path');\nconst os = require('os');\nconst ctx = this;\nconst v = ctx.variables;\nconst ui = ctx.clientUiAutomator;\nconst diagnostic = v.diagnostic_only === true || v.diagnostic_only === 1 || /^(true|1)$/i.test(String(v.diagnostic_only));\nconst folder = path.join(os.tmpdir(), 'opencode', 'GenFarmer-TiktokLive', String(ctx.runId || Date.now()).replace(/[^\\w-]/g, '_'), String(ctx.deviceId));\nfs.mkdirSync(folder, { recursive: true });\nconst result = { serial: ctx.deviceId, url: String(v.contentUrl || ''), mode: diagnostic ? 'diagnostic' : 'publish', status: 'running', evidence: folder, screens: [] };\nconst save = () => fs.writeFileSync(path.join(folder, 'result.json'), JSON.stringify(result, null, 2));\nconst wait = ms => new Promise(resolve => setTimeout(resolve, ms));\nfunction nodes(xml) {\n  const found = [];\n  for (const tag of xml.match(/<node\\b[^>]*>/g) || []) {\n    const node = {};\n    for (const attr of tag.matchAll(/([\\w-]+)\\s*=\\s*([\"'])(.*?)\\2/g)) node[attr[1]] = attr[3];\n    const bounds = String(node.bounds || '').match(/^\\[(-?\\d+),(-?\\d+)\\]\\[(-?\\d+),(-?\\d+)\\]$/);\n    if (bounds) { node.bounds = bounds.slice(1).map(Number); found.push(node); }\n  }\n  return found;\n}\nasync function rpc(method, params) {\n  const response = await ui.callRpc(method, params, 10000, 5);\n  if (!response || response.error || response.result === false) throw new Error('Operacion UI no confirmada: ' + method);\n  return response.result;\n}\nasync function capture(label) {\n  const xml = await ctx.getXml();\n  fs.writeFileSync(path.join(folder, label + '.xml'), xml);\n  const image = await ui.screenShotToBuffer();\n  if (!image || !image.length) throw new Error('Captura de pantalla vacia.');\n  fs.writeFileSync(path.join(folder, label + '.png'), image);\n  result.screens.push(label);\n  save();\n  return nodes(xml);\n}\nasync function click(node, purpose) {\n  if (!node || !node.bounds || node.bounds[2] <= node.bounds[0] || node.bounds[3] <= node.bounds[1]) throw new Error('Control ausente: ' + purpose);\n  await rpc('click', [Math.round((node.bounds[0] + node.bounds[2]) / 2), Math.round((node.bounds[1] + node.bounds[3]) / 2)]);\n}\ntry {\n  if (!diagnostic) throw new Error('TikTok Live aun requiere diagnostico visual; no se publico ninguna accion.');\n  let liveNodes;\n  for (let attempt = 0; attempt < 20; attempt++) {\n    await wait(1000);\n    liveNodes = await capture('ready-' + (attempt + 1));\n    if (liveNodes.some(node => /:id\\/gjl$/.test(node['resource-id'] || '')) && liveNodes.some(node => /:id\\/u9q$/.test(node['resource-id'] || ''))) break;\n  }\n  const comment = liveNodes.find(node => /:id\\/gjl$/.test(node['resource-id'] || ''));\n  const share = liveNodes.find(node => /:id\\/u9q$/.test(node['resource-id'] || ''));\n  if (!comment || !share) throw new Error('No se identificaron los controles del Live.');\n  await click(comment, 'abrir editor de comentario');\n  await wait(1200);\n  await capture('comment-open');\n  await rpc('pressKey', ['back']);\n  await wait(800);\n  liveNodes = await capture('comment-closed');\n  await click(liveNodes.find(node => /:id\\/u9q$/.test(node['resource-id'] || '')), 'abrir compartir');\n  await wait(1200);\n  await capture('share-open');\n  await rpc('pressKey', ['back']);\n  result.status = 'success';\n  result.summary = 'Editor y hoja de compartir del Live identificados sin acciones publicas.';\n  v.tiktok_summary = result.summary;\n  save();\n} catch (error) {\n  result.status = 'failed';\n  result.error = String(error && error.message || error);\n  v.tiktok_error = result.error;\n  save();\n  throw new Error('TIKTOK_LIVE_ACTION_ERROR: consultar tiktok_error y result.json.');\n}\n"
