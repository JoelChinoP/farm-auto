APP_NAME=Farm Auto API
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/app.db
FRONTEND_URL=http://localhost:5173
GENFARMER_URL=http://127.0.0.1:55554
GENFARMER_TIMEOUT=10
# Importar los cuatro .genfarm en GenFarmer y copiar sus IDs reales aqui.
GENFARMER_OPEN_APP_ID=
GENFARMER_FACEBOOK_APP_ID=
GENFARMER_FACEBOOK_LIVE_ROUNDS_APP_ID=
GENFARMER_TIKTOK_APP_ID=
# Segundos de pausa entre handoffs a GenFarmer. Subir si GenFarmer se satura
# con lotes grandes (4 publicaciones x 33 equipos = 132 tareas).
GENFARMER_DISPATCH_GAP=1
# Segundos entre consultas de finalizacion de los runs activos. La siguiente
# publicacion de un equipo no sale hasta confirmar su run y dispositivo terminales.
GENFARMER_COMPLETION_POLL=5
# --- Comentarios con IA (DeepSeek) ---
# Pega aqui tu API key. Si queda vacia, se usa la del .env de la raiz.
# Sin ninguna clave, "Generar con IA" responde 503.
API_DEEPSEEK=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=45
# Descomenta para personalizar; si esta vacio se usa el .env de la raiz
# o el prompt descriptivo por defecto del backend.
# COMMENT_GENERATION_PROMPT=
COMMENT_MIN_WORDS=5
COMMENT_MAX_WORDS=15
