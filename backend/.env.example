APP_NAME=Farm Auto API
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/app.db
FRONTEND_URL=http://localhost:5173
GENFARMER_URL=http://127.0.0.1:55554
GENFARMER_TIMEOUT=10
# Importar los tres .genfarm en GenFarmer y copiar sus IDs reales aqui.
GENFARMER_OPEN_APP_ID=
GENFARMER_FACEBOOK_APP_ID=
GENFARMER_TIKTOK_APP_ID=
# true: POST /runs y PUT /runs/:id/run (documentacion publica).
# false: solo para builds comprobadas que inician al crear el run.
GENFARMER_EXPLICIT_START=true
