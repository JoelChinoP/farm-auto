# GenFarmer must stay local. Defaults are shown here explicitly.
GENFARMER_URL=http://127.0.0.1:55554
GENFARMER_USER_ID=30299

# DeepSeek stays server-side and is never exposed to the browser.
API_DEEPSEEK=
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional overrides.
# ADB_PATH=C:\\path\\to\\adb.exe
# CONTROL_PANEL_DB_PATH=E:\\genfarm\\control-panel\\data\\control-panel.sqlite
