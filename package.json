{
  "name": "farm-appium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/**/*.test.ts",
    "test:e2e:appium": "node --env-file-if-exists=.env --test --experimental-strip-types e2e/appium/smoke.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "worker": "node --env-file-if-exists=.env --experimental-strip-types src/worker.ts",
    "appium:server": "appium server --address 127.0.0.1 --port 4723 --use-drivers=uiautomator2",
    "appium:doctor": "appium driver doctor uiautomator2"
  },
  "dependencies": {
    "@mantine/core": "9.6.0",
    "@mantine/hooks": "9.6.0",
    "better-sqlite3": "13.0.3",
    "next": "16.3.4",
    "playwright-core": "^1.61.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "appium": "3.7.0",
    "appium-uiautomator2-driver": "8.5.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "appium@3.7.0": true,
    "unrs-resolver": false
  }
}
