flowchart TD
  NAV["Navegacion principal"] --> DEV["1. Dispositivos"]
  NAV --> FB["2. Facebook"]
  NAV --> TT["3. TikTok"]
  NAV --> HIST["4. Historial"]

  DEV --> REG["Allowlist editable de IDs"]
  REG --> READY["Validar ADB, app, sesion y preparacion por plataforma"]

  FB --> BUILDER["Constructor de campana compartido"]
  TT --> BUILDER
  BUILDER --> SELECT["Seleccionar dispositivos elegibles"]
  SELECT --> URLS["Agregar y validar 1 a 10 publicaciones"]
  URLS --> ACTIONS["Elegir acciones"]
  ACTIONS --> EXTRACT["Encolar extraccion de contexto"]
  EXTRACT --> FIRST["Primera publicacion con prioridad"]
  EXTRACT --> REST["Demas publicaciones en segundo plano"]
  FIRST --> DRAFTS["Generar comentarios por publicacion"]
  REST --> DRAFTS
  DRAFTS --> PLAN["Persistir horario aleatorio por dispositivo y publicacion"]
  PLAN --> REVIEW["Revisar comentarios, horarios y acciones"]
  REVIEW --> START["Confirmacion explicita e inicio"]
  START --> JOBS["Jobs independientes por dispositivo y publicacion"]
  JOBS --> OK["Completado"]
  JOBS --> FAIL["Fallo aislado"]
  JOBS --> UNKNOWN["Resultado publico incierto"]
  OK --> HIST
  FAIL --> HIST
  UNKNOWN --> HIST

  ABORT["Abortar todo"] --> CANCEL["Persistir cancel_requested"]
  CANCEL --> STOP["Detener nuevos claims y cancelar tareas activas"]
  STOP --> CLEAN["Cerrar sesiones con timeout por dispositivo"]
  CLEAN --> HOME["Enviar HOME por ADB"]
  HOME --> HIST
