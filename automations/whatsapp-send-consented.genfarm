{
  "id": "control-panel-whatsapp-consented",
  "userId": 0,
  "name": "Control Panel - WhatsApp consentido",
  "description": "Envía un único mensaje aprobado a un contacto con consentimiento y vuelve a inicio.",
  "logo": null,
  "version": "1.0.0",
  "script": {
    "id": "control-panel-whatsapp-consented",
    "name": "Control Panel - WhatsApp consentido",
    "description": "Envía un único mensaje aprobado a un contacto con consentimiento y vuelve a inicio.",
    "version": "1.0.0",
    "variables": [
      {
        "id": "phone_number",
        "name": "phoneNumber",
        "label": "Número internacional",
        "value": "",
        "secret": false
      },
      {
        "id": "message_text",
        "name": "messageText",
        "label": "Mensaje aprobado",
        "value": "",
        "secret": false
      }
    ],
    "flow": {
      "nodes": [
        {
          "id": "whatsapp_start",
          "type": "input",
          "position": { "x": 60, "y": 180 },
          "data": {
            "action": "Start",
            "options": {},
            "successNode": "whatsapp_open",
            "failNode": null
          },
          "label": "Start",
          "sourcePosition": "right",
          "targetPosition": "left",
          "deletable": false,
          "class": ""
        },
        {
          "id": "whatsapp_open",
          "type": "custom",
          "position": { "x": 290, "y": 180 },
          "data": {
            "icon": "terminal",
            "action": "Adb",
            "options": {
              "command": "am start -W -a android.intent.action.VIEW -d \"https://wa.me/${phoneNumber}\" -p com.whatsapp",
              "outputVariable": null,
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "45",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "whatsapp_wait",
            "failNode": null
          },
          "label": "Abrir chat",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "whatsapp_wait",
          "type": "custom",
          "position": { "x": 520, "y": 180 },
          "data": {
            "icon": "pause",
            "action": "Pause",
            "options": {
              "timeoutType": "fixed",
              "timeout": "3",
              "timeoutFrom": "1",
              "timeoutTo": "3",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "0",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "whatsapp_type",
            "failNode": null
          },
          "label": "Esperar chat",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "whatsapp_type",
          "type": "custom",
          "position": { "x": 750, "y": 180 },
          "data": {
            "icon": "typeText",
            "action": "TypeText",
            "options": {
              "xpath": "//*[@resource-id='com.whatsapp:id/entry']",
              "text": "${messageText}",
              "timeout": "12",
              "typeAsHuman": false,
              "typeSpeed": 1,
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "45",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "whatsapp_send",
            "failNode": null
          },
          "label": "Escribir mensaje",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "whatsapp_send",
          "type": "custom",
          "position": { "x": 980, "y": 180 },
          "data": {
            "icon": "touch",
            "action": "Touch",
            "options": {
              "selectorBy": "selector",
              "touchType": "normal",
              "xpath": "//*[@resource-id='com.whatsapp:id/send' or @content-desc='Send' or @content-desc='Enviar']",
              "timeout": "12",
              "delay": "",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "45",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "whatsapp_log",
            "failNode": null
          },
          "label": "Enviar una vez",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "whatsapp_log",
          "type": "custom",
          "position": { "x": 1210, "y": 180 },
          "data": {
            "icon": "log",
            "action": "Log",
            "options": {
              "log": "Mensaje individual enviado al contacto aprobado.",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "30",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "whatsapp_home",
            "failNode": null
          },
          "label": "Registrar envío",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "whatsapp_home",
          "type": "custom",
          "position": { "x": 1440, "y": 180 },
          "data": {
            "icon": "actionPressHome",
            "action": "PressHome",
            "options": {
              "disabled": false,
              "nodeSleep": "1",
              "nodeTimeout": "30",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "whatsapp_stop",
            "failNode": null
          },
          "label": "Volver a inicio",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "whatsapp_stop",
          "type": "custom",
          "position": { "x": 1670, "y": 180 },
          "data": {
            "icon": "stop",
            "action": "Stop",
            "options": {},
            "successNode": null,
            "failNode": null
          },
          "label": "Stop",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        }
      ],
      "edges": [
        {
          "id": "edge-whatsapp-start-open",
          "type": "custom",
          "source": "whatsapp_start",
          "target": "whatsapp_open",
          "sourceHandle": "whatsapp_start",
          "targetHandle": "success",
          "data": { "sourceHandle": "whatsapp_start", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-whatsapp_start target-whatsapp_open"
        },
        {
          "id": "edge-whatsapp-open-wait",
          "type": "custom",
          "source": "whatsapp_open",
          "target": "whatsapp_wait",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-whatsapp_open target-whatsapp_wait"
        },
        {
          "id": "edge-whatsapp-wait-type",
          "type": "custom",
          "source": "whatsapp_wait",
          "target": "whatsapp_type",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-whatsapp_wait target-whatsapp_type"
        },
        {
          "id": "edge-whatsapp-type-send",
          "type": "custom",
          "source": "whatsapp_type",
          "target": "whatsapp_send",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-whatsapp_type target-whatsapp_send"
        },
        {
          "id": "edge-whatsapp-send-log",
          "type": "custom",
          "source": "whatsapp_send",
          "target": "whatsapp_log",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-whatsapp_send target-whatsapp_log"
        },
        {
          "id": "edge-whatsapp-log-home",
          "type": "custom",
          "source": "whatsapp_log",
          "target": "whatsapp_home",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-whatsapp_log target-whatsapp_home"
        },
        {
          "id": "edge-whatsapp-home-stop",
          "type": "custom",
          "source": "whatsapp_home",
          "target": "whatsapp_stop",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-whatsapp_home target-whatsapp_stop"
        }
      ]
    }
  }
}
