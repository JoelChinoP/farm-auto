{
  "id": "control-panel-device-home",
  "userId": 0,
  "name": "Control Panel - Pantalla de inicio",
  "description": "Lleva un dispositivo a la pantalla principal para comenzar desde un estado conocido.",
  "logo": null,
  "version": "1.0.0",
  "script": {
    "id": "control-panel-device-home",
    "name": "Control Panel - Pantalla de inicio",
    "description": "Lleva un dispositivo a la pantalla principal para comenzar desde un estado conocido.",
    "version": "1.0.0",
    "variables": [],
    "flow": {
      "nodes": [
        {
          "id": "home_start",
          "type": "input",
          "position": { "x": 80, "y": 180 },
          "data": {
            "action": "Start",
            "options": {},
            "successNode": "home_press",
            "failNode": null
          },
          "label": "Start",
          "sourcePosition": "right",
          "targetPosition": "left",
          "deletable": false,
          "class": ""
        },
        {
          "id": "home_press",
          "type": "custom",
          "position": { "x": 330, "y": 180 },
          "data": {
            "icon": "actionPressHome",
            "action": "PressHome",
            "options": {
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "30",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "home_log",
            "failNode": null
          },
          "label": "Ir a inicio",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "home_log",
          "type": "custom",
          "position": { "x": 580, "y": 180 },
          "data": {
            "icon": "log",
            "action": "Log",
            "options": {
              "log": "Dispositivo en la pantalla de inicio.",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "30",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "home_stop",
            "failNode": null
          },
          "label": "Registrar resultado",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "home_stop",
          "type": "custom",
          "position": { "x": 830, "y": 180 },
          "data": {
            "icon": "stop",
            "action": "Stop",
            "options": {},
            "successNode": null,
            "failNode": null
          },
          "label": "Stop",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        }
      ],
      "edges": [
        {
          "id": "edge-home-start-press",
          "type": "custom",
          "source": "home_start",
          "target": "home_press",
          "sourceHandle": "home_start",
          "targetHandle": "success",
          "data": { "sourceHandle": "home_start", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-home_start target-home_press"
        },
        {
          "id": "edge-home-press-log",
          "type": "custom",
          "source": "home_press",
          "target": "home_log",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-home_press target-home_log"
        },
        {
          "id": "edge-home-log-stop",
          "type": "custom",
          "source": "home_log",
          "target": "home_stop",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-home_log target-home_stop"
        }
      ]
    }
  }
}
