{
  "id": "control-panel-tiktok-live-tap-tap",
  "userId": 0,
  "name": "Control Panel - TikTok Live tap tap",
  "description": "Abre un Live de TikTok y ejecuta una cantidad acotada de gestos de doble toque en coordenadas configurables.",
  "logo": null,
  "version": "1.0.0",
  "input": [
    {
      "id": "input-live-url",
      "type": "input",
      "name": "Enlace del Live",
      "options": {
        "variable": {
          "id": "live_url",
          "name": "liveUrl",
          "label": "Enlace del Live",
          "value": "",
          "secret": false
        },
        "hideLabel": false,
        "value": "",
        "placeholder": "https://www.tiktok.com/@usuario/live",
        "width": null,
        "height": null,
        "labelWidth": 180,
        "maxLength": 2048,
        "minLength": 12,
        "disabled": false,
        "showCount": false
      }
    },
    {
      "id": "number-tap-rounds",
      "type": "number",
      "name": "Rondas de tap tap",
      "options": {
        "variable": {
          "id": "tap_rounds",
          "name": "tapRounds",
          "label": "Rondas de tap tap",
          "value": "",
          "secret": false
        },
        "hideLabel": false,
        "title": "Rondas de tap tap",
        "value": null,
        "width": null,
        "height": null,
        "labelWidth": 180,
        "bordered": true,
        "clearable": true,
        "min": 1,
        "max": 50,
        "placeholder": "1 a 50",
        "readonly": false,
        "showButton": true,
        "step": 1
      }
    },
    {
      "id": "number-tap-x",
      "type": "number",
      "name": "Coordenada X",
      "options": {
        "variable": {
          "id": "tap_x",
          "name": "tapX",
          "label": "Coordenada X",
          "value": "",
          "secret": false
        },
        "hideLabel": false,
        "title": "Coordenada X",
        "value": null,
        "width": null,
        "height": null,
        "labelWidth": 180,
        "bordered": true,
        "clearable": true,
        "min": 0,
        "max": 5000,
        "placeholder": "Ejemplo: 540",
        "readonly": false,
        "showButton": true,
        "step": 1
      }
    },
    {
      "id": "number-tap-y",
      "type": "number",
      "name": "Coordenada Y",
      "options": {
        "variable": {
          "id": "tap_y",
          "name": "tapY",
          "label": "Coordenada Y",
          "value": "",
          "secret": false
        },
        "hideLabel": false,
        "title": "Coordenada Y",
        "value": null,
        "width": null,
        "height": null,
        "labelWidth": 180,
        "bordered": true,
        "clearable": true,
        "min": 0,
        "max": 5000,
        "placeholder": "Ejemplo: 960",
        "readonly": false,
        "showButton": true,
        "step": 1
      }
    }
  ],
  "script": {
    "id": "control-panel-tiktok-live-tap-tap",
    "name": "Control Panel - TikTok Live tap tap",
    "description": "Abre un Live de TikTok y ejecuta una cantidad acotada de gestos de doble toque en coordenadas configurables.",
    "version": "1.0.0",
    "variables": [
      {
        "id": "live_url",
        "name": "liveUrl",
        "label": "Enlace del Live",
        "value": "",
        "secret": false
      },
      {
        "id": "tap_rounds",
        "name": "tapRounds",
        "label": "Rondas de tap tap",
        "value": "",
        "secret": false
      },
      {
        "id": "tap_x",
        "name": "tapX",
        "label": "Coordenada X",
        "value": "",
        "secret": false
      },
      {
        "id": "tap_y",
        "name": "tapY",
        "label": "Coordenada Y",
        "value": "",
        "secret": false
      }
    ],
    "flow": {
      "nodes": [
        {
          "id": "live_start",
          "type": "input",
          "position": { "x": 60, "y": 220 },
          "data": {
            "action": "Start",
            "options": {},
            "successNode": "live_open_app",
            "failNode": null
          },
          "label": "Start",
          "sourcePosition": "right",
          "targetPosition": "left",
          "deletable": false,
          "class": ""
        },
        {
          "id": "live_open_app",
          "type": "custom",
          "position": { "x": 300, "y": 220 },
          "data": {
            "icon": "play",
            "action": "StartApp",
            "options": {
              "packageName": "com.zhiliaoapp.musically",
              "timeout": "30",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "45",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "live_open_url",
            "failNode": "live_fail_log"
          },
          "label": "Abrir TikTok",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "live_open_url",
          "type": "custom",
          "position": { "x": 540, "y": 220 },
          "data": {
            "icon": "terminal",
            "action": "Adb",
            "options": {
              "command": "am start -W -a android.intent.action.VIEW -d '${liveUrl}' -p com.zhiliaoapp.musically",
              "outputVariable": null,
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "45",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "live_wait",
            "failNode": "live_fail_log"
          },
          "label": "Abrir Live",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "live_wait",
          "type": "custom",
          "position": { "x": 780, "y": 220 },
          "data": {
            "icon": "actionPause",
            "action": "Pause",
            "options": {
              "timeoutType": "fixed",
              "timeout": "5",
              "timeoutFrom": "1",
              "timeoutTo": "3",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "10",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "live_loop",
            "failNode": "live_fail_log"
          },
          "label": "Esperar Live",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "live_loop",
          "type": "loop",
          "position": { "x": 1020, "y": 220 },
          "data": {
            "icon": "actionLoop",
            "action": "Loop",
            "options": {
              "loopType": "For",
              "forFrom": "1",
              "forTo": "${tapRounds}",
              "forEachFrom": "",
              "forEachValue": "",
              "whileLeftOperand": "",
              "whileOperator": null,
              "whileRightperand": "",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "30",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "live_success_log",
            "failNode": "live_fail_log",
            "startLoopNode": "live_double_tap"
          },
          "label": "Repetir tap tap",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "live_double_tap",
          "type": "custom",
          "position": { "x": 1260, "y": 40 },
          "data": {
            "icon": "actionMouseMove",
            "action": "Touch",
            "options": {
              "selectorBy": "coordinates",
              "touchType": "double",
              "selector": "",
              "xpath": "",
              "x": "${tapX}",
              "y": "${tapY}",
              "touchCount": "1",
              "delay": "120",
              "timeout": "10",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "30",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "live_tap_pause",
            "failNode": "live_fail_log"
          },
          "label": "Doble toque",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "live_tap_pause",
          "type": "custom",
          "position": { "x": 1500, "y": 40 },
          "data": {
            "icon": "actionPause",
            "action": "Pause",
            "options": {
              "timeoutType": "fixed",
              "timeout": "0.4",
              "timeoutFrom": "1",
              "timeoutTo": "3",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "5",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "live_loop",
            "failNode": "live_fail_log"
          },
          "label": "Pausa entre rondas",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "live_success_log",
          "type": "custom",
          "position": { "x": 1260, "y": 300 },
          "data": {
            "icon": "file",
            "action": "Log",
            "options": {
              "log": "Interacción de tap tap completada: ${tapRounds} rondas.",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "30",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "live_stop",
            "failNode": null
          },
          "label": "Registrar resultado",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "live_fail_log",
          "type": "custom",
          "position": { "x": 1020, "y": 500 },
          "data": {
            "icon": "file",
            "action": "Log",
            "options": {
              "log": "[Failed] No se pudo completar la interacción en el Live de TikTok.",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "30",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "live_stop",
            "failNode": null
          },
          "label": "Registrar error",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "live_stop",
          "type": "custom",
          "position": { "x": 1500, "y": 300 },
          "data": {
            "icon": "actionStop",
            "action": "Stop",
            "options": {},
            "successNode": null,
            "failNode": null
          },
          "label": "Stop",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        }
      ],
      "edges": [
        {
          "id": "edge-live-start-open-app",
          "type": "custom",
          "source": "live_start",
          "target": "live_open_app",
          "sourceHandle": "live_start",
          "targetHandle": "success",
          "data": { "sourceHandle": "live_start", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-live_start target-live_open_app"
        },
        {
          "id": "edge-live-open-app-open-url",
          "type": "custom",
          "source": "live_open_app",
          "target": "live_open_url",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-live_open_app target-live_open_url"
        },
        {
          "id": "edge-live-open-url-wait",
          "type": "custom",
          "source": "live_open_url",
          "target": "live_wait",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-live_open_url target-live_wait"
        },
        {
          "id": "edge-live-wait-loop",
          "type": "custom",
          "source": "live_wait",
          "target": "live_loop",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-live_wait target-live_loop"
        },
        {
          "id": "edge-live-loop-double-tap",
          "type": "custom",
          "source": "live_loop",
          "target": "live_double_tap",
          "sourceHandle": "startLoopNode",
          "targetHandle": "success",
          "data": { "sourceHandle": "startLoopNode", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#f0a020", "strokeWidth": 2 },
          "animated": true,
          "class": "source-live_loop target-live_double_tap"
        },
        {
          "id": "edge-live-double-tap-pause",
          "type": "custom",
          "source": "live_double_tap",
          "target": "live_tap_pause",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-live_double_tap target-live_tap_pause"
        },
        {
          "id": "edge-live-pause-loop",
          "type": "custom",
          "source": "live_tap_pause",
          "target": "live_loop",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-live_tap_pause target-live_loop"
        },
        {
          "id": "edge-live-loop-success-log",
          "type": "custom",
          "source": "live_loop",
          "target": "live_success_log",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-live_loop target-live_success_log"
        },
        {
          "id": "edge-live-success-log-stop",
          "type": "custom",
          "source": "live_success_log",
          "target": "live_stop",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-live_success_log target-live_stop"
        },
        {
          "id": "edge-live-fail-log-stop",
          "type": "custom",
          "source": "live_fail_log",
          "target": "live_stop",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-live_fail_log target-live_stop"
        },
        {
          "id": "edge-live-open-app-fail",
          "type": "custom",
          "source": "live_open_app",
          "target": "live_fail_log",
          "sourceHandle": "fail",
          "targetHandle": "success",
          "data": { "sourceHandle": "fail", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#d03050", "strokeWidth": 2 },
          "animated": true,
          "class": "source-live_open_app target-live_fail_log"
        },
        {
          "id": "edge-live-open-url-fail",
          "type": "custom",
          "source": "live_open_url",
          "target": "live_fail_log",
          "sourceHandle": "fail",
          "targetHandle": "success",
          "data": { "sourceHandle": "fail", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#d03050", "strokeWidth": 2 },
          "animated": true,
          "class": "source-live_open_url target-live_fail_log"
        },
        {
          "id": "edge-live-wait-fail",
          "type": "custom",
          "source": "live_wait",
          "target": "live_fail_log",
          "sourceHandle": "fail",
          "targetHandle": "success",
          "data": { "sourceHandle": "fail", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#d03050", "strokeWidth": 2 },
          "animated": true,
          "class": "source-live_wait target-live_fail_log"
        },
        {
          "id": "edge-live-loop-fail",
          "type": "custom",
          "source": "live_loop",
          "target": "live_fail_log",
          "sourceHandle": "fail",
          "targetHandle": "success",
          "data": { "sourceHandle": "fail", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#d03050", "strokeWidth": 2 },
          "animated": true,
          "class": "source-live_loop target-live_fail_log"
        },
        {
          "id": "edge-live-double-tap-fail",
          "type": "custom",
          "source": "live_double_tap",
          "target": "live_fail_log",
          "sourceHandle": "fail",
          "targetHandle": "success",
          "data": { "sourceHandle": "fail", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#d03050", "strokeWidth": 2 },
          "animated": true,
          "class": "source-live_double_tap target-live_fail_log"
        },
        {
          "id": "edge-live-tap-pause-fail",
          "type": "custom",
          "source": "live_tap_pause",
          "target": "live_fail_log",
          "sourceHandle": "fail",
          "targetHandle": "success",
          "data": { "sourceHandle": "fail", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#d03050", "strokeWidth": 2 },
          "animated": true,
          "class": "source-live_tap_pause target-live_fail_log"
        }
      ]
    }
  }
}
