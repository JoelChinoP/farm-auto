{
  "id": "control-panel-tiktok-post-like-comment",
  "userId": 0,
  "name": "Control Panel - TikTok like y comentario",
  "description": "Abre una publicación de TikTok, da like con doble toque y publica un único comentario previamente aprobado.",
  "logo": null,
  "version": "1.0.0",
  "input": [
    {
      "id": "input-content-url",
      "type": "input",
      "name": "Enlace de la publicación",
      "options": {
        "variable": {
          "id": "content_url",
          "name": "contentUrl",
          "label": "Enlace de la publicación",
          "value": "",
          "secret": false
        },
        "hideLabel": false,
        "value": "",
        "placeholder": "https://www.tiktok.com/@usuario/video/...",
        "width": null,
        "height": null,
        "labelWidth": 190,
        "maxLength": 2048,
        "minLength": 12,
        "disabled": false,
        "showCount": false
      }
    },
    {
      "id": "textarea-comment-text",
      "type": "textarea",
      "name": "Comentario aprobado",
      "options": {
        "variable": {
          "id": "comment_text",
          "name": "commentText",
          "label": "Comentario aprobado",
          "value": "",
          "secret": false
        },
        "hideLabel": false,
        "value": "",
        "placeholder": "Texto generado con DeepSeek y aprobado por el operador",
        "width": null,
        "height": 100,
        "labelWidth": 190,
        "maxLength": 500,
        "minLength": 2,
        "disabled": false,
        "showCount": true
      }
    }
  ],
  "script": {
    "id": "control-panel-tiktok-post-like-comment",
    "name": "Control Panel - TikTok like y comentario",
    "description": "Abre una publicación de TikTok, da like con doble toque y publica un único comentario previamente aprobado.",
    "version": "1.0.0",
    "variables": [
      {
        "id": "content_url",
        "name": "contentUrl",
        "label": "Enlace de la publicación",
        "value": "",
        "secret": false
      },
      {
        "id": "comment_text",
        "name": "commentText",
        "label": "Comentario aprobado",
        "value": "",
        "secret": false
      }
    ],
    "flow": {
      "nodes": [
        {
          "id": "post_start",
          "type": "input",
          "position": { "x": 60, "y": 200 },
          "data": {
            "action": "Start",
            "options": {},
            "successNode": "post_open_app",
            "failNode": null
          },
          "label": "Start",
          "sourcePosition": "right",
          "targetPosition": "left",
          "deletable": false,
          "class": ""
        },
        {
          "id": "post_open_app",
          "type": "custom",
          "position": { "x": 290, "y": 200 },
          "data": {
            "icon": "play",
            "action": "StartApp",
            "options": {
              "packageName": "com.zhiliaoapp.musically",
              "timeout": "30",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "45",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "post_open_url",
            "failNode": null
          },
          "label": "Abrir TikTok",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "post_open_url",
          "type": "custom",
          "position": { "x": 520, "y": 200 },
          "data": {
            "icon": "terminal",
            "action": "Adb",
            "options": {
              "command": "am start -W -a android.intent.action.VIEW -d '${contentUrl}' -p com.zhiliaoapp.musically",
              "outputVariable": null,
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "45",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "post_wait",
            "failNode": null
          },
          "label": "Abrir publicación",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "post_wait",
          "type": "custom",
          "position": { "x": 750, "y": 200 },
          "data": {
            "icon": "actionPause",
            "action": "Pause",
            "options": {
              "timeoutType": "fixed",
              "timeout": "5",
              "timeoutFrom": "1",
              "timeoutTo": "3",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "10",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "post_like",
            "failNode": null
          },
          "label": "Esperar publicación",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "post_like",
          "type": "custom",
          "position": { "x": 980, "y": 200 },
          "data": {
            "icon": "terminal",
            "action": "Adb",
            "options": {
              "command": "size=$(wm size | tail -n 1 | awk '{print $NF}'); w=$(echo $size | cut -d x -f 1); h=$(echo $size | cut -d x -f 2); x=$((w/2)); y=$((h*45/100)); input tap $x $y; sleep 0.12; input tap $x $y",
              "outputVariable": null,
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "15",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "post_like_pause",
            "failNode": null
          },
          "label": "Dar like",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "post_like_pause",
          "type": "custom",
          "position": { "x": 1210, "y": 200 },
          "data": {
            "icon": "actionPause",
            "action": "Pause",
            "options": {
              "timeoutType": "fixed",
              "timeout": "1",
              "timeoutFrom": "1",
              "timeoutTo": "3",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "5",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "post_open_comments",
            "failNode": null
          },
          "label": "Esperar like",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "post_open_comments",
          "type": "custom",
          "position": { "x": 1440, "y": 200 },
          "data": {
            "icon": "actionMouseMove",
            "action": "Touch",
            "options": {
              "selectorBy": "selector",
              "touchType": "normal",
              "selector": "",
              "xpath": "//*[contains(@content-desc,'Comment') or contains(@content-desc,'comment') or contains(@content-desc,'Comentarios') or contains(@content-desc,'comentarios')]",
              "x": "",
              "y": "",
              "touchCount": "1",
              "delay": "",
              "timeout": "15",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "30",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "post_comments_wait",
            "failNode": null
          },
          "label": "Abrir comentarios",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "post_comments_wait",
          "type": "custom",
          "position": { "x": 1670, "y": 200 },
          "data": {
            "icon": "actionPause",
            "action": "Pause",
            "options": {
              "timeoutType": "fixed",
              "timeout": "2",
              "timeoutFrom": "1",
              "timeoutTo": "3",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "5",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "post_type_comment",
            "failNode": null
          },
          "label": "Esperar comentarios",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "post_type_comment",
          "type": "custom",
          "position": { "x": 1900, "y": 200 },
          "data": {
            "icon": "actionTypeText",
            "action": "TypeText",
            "options": {
              "xpath": "//*[@class='android.widget.EditText' and (@clickable='true' or @focusable='true')]",
              "text": "${commentText}",
              "timeout": "15",
              "typeAsHuman": false,
              "typeSpeed": 1,
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "45",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "post_send_comment",
            "failNode": null
          },
          "label": "Escribir comentario",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "post_send_comment",
          "type": "custom",
          "position": { "x": 2130, "y": 200 },
          "data": {
            "icon": "actionMouseMove",
            "action": "Touch",
            "options": {
              "selectorBy": "selector",
              "touchType": "normal",
              "selector": "",
              "xpath": "//*[contains(@content-desc,'Post comment') or contains(@content-desc,'post comment') or contains(@content-desc,'Publicar comentario') or contains(@content-desc,'Enviar comentario') or @text='Post' or @text='Publicar' or @text='Enviar']",
              "x": "",
              "y": "",
              "touchCount": "1",
              "delay": "",
              "timeout": "15",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "30",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "post_log",
            "failNode": null
          },
          "label": "Publicar una vez",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "post_log",
          "type": "custom",
          "position": { "x": 2360, "y": 200 },
          "data": {
            "icon": "file",
            "action": "Log",
            "options": {
              "log": "Like y comentario aprobado publicados en TikTok.",
              "disabled": false,
              "nodeSleep": "1",
              "nodeTimeout": "30",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "post_home",
            "failNode": null
          },
          "label": "Registrar resultado",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "post_home",
          "type": "custom",
          "position": { "x": 2590, "y": 200 },
          "data": {
            "icon": "actionPressHome",
            "action": "PressHome",
            "options": {
              "disabled": false,
              "nodeSleep": "1",
              "nodeTimeout": "30",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "post_stop",
            "failNode": null
          },
          "label": "Volver a inicio",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "post_stop",
          "type": "custom",
          "position": { "x": 2820, "y": 200 },
          "data": {
            "icon": "actionStop",
            "action": "Stop",
            "options": {},
            "successNode": null,
            "failNode": null
          },
          "label": "Stop",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        }
      ],
      "edges": [
        {
          "id": "edge-post-start-open-app",
          "type": "custom",
          "source": "post_start",
          "target": "post_open_app",
          "sourceHandle": "post_start",
          "targetHandle": "success",
          "data": { "sourceHandle": "post_start", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-post_start target-post_open_app"
        },
        {
          "id": "edge-post-open-app-open-url",
          "type": "custom",
          "source": "post_open_app",
          "target": "post_open_url",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-post_open_app target-post_open_url"
        },
        {
          "id": "edge-post-open-url-wait",
          "type": "custom",
          "source": "post_open_url",
          "target": "post_wait",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-post_open_url target-post_wait"
        },
        {
          "id": "edge-post-wait-like",
          "type": "custom",
          "source": "post_wait",
          "target": "post_like",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-post_wait target-post_like"
        },
        {
          "id": "edge-post-like-pause",
          "type": "custom",
          "source": "post_like",
          "target": "post_like_pause",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-post_like target-post_like_pause"
        },
        {
          "id": "edge-post-like-pause-open-comments",
          "type": "custom",
          "source": "post_like_pause",
          "target": "post_open_comments",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-post_like_pause target-post_open_comments"
        },
        {
          "id": "edge-post-open-comments-wait",
          "type": "custom",
          "source": "post_open_comments",
          "target": "post_comments_wait",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-post_open_comments target-post_comments_wait"
        },
        {
          "id": "edge-post-comments-wait-type",
          "type": "custom",
          "source": "post_comments_wait",
          "target": "post_type_comment",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-post_comments_wait target-post_type_comment"
        },
        {
          "id": "edge-post-type-send",
          "type": "custom",
          "source": "post_type_comment",
          "target": "post_send_comment",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-post_type_comment target-post_send_comment"
        },
        {
          "id": "edge-post-send-log",
          "type": "custom",
          "source": "post_send_comment",
          "target": "post_log",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-post_send_comment target-post_log"
        },
        {
          "id": "edge-post-log-home",
          "type": "custom",
          "source": "post_log",
          "target": "post_home",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-post_log target-post_home"
        },
        {
          "id": "edge-post-home-stop",
          "type": "custom",
          "source": "post_home",
          "target": "post_stop",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-post_home target-post_stop"
        }
      ]
    }
  }
}
