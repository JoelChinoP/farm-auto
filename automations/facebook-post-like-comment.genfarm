          "type": "custom",
          "position": { "x": 1440, "y": 20 },
          "data": {
            "icon": "actionEval",
            "action": "Javascript",
            "options": {
              "script": "if (this.variables.facebookInterface !== 'target-marker-bound') throw new Error('La publicacion objetivo no fue vinculada antes del desplazamiento.'); const simplify = (value) => Array.from(String(value || '').replace(/&amp;/g, '&').replace(/&quot;/g, ' ').replace(/&apos;/g, ' ').normalize('NFD')).filter((character) => { const code = character.charCodeAt(0); return code < 768 || code > 879; }).join('').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim(); const { xmlDump } = await this.clientUiAutomator.dumpWindowHierarchy(); if (!xmlDump || !xmlDump.includes('<hierarchy')) throw new Error('Facebook no expuso una interfaz accesible.'); const quote = String.fromCharCode(34); const attr = (tag, name) => { const key = name + '=' + quote; const start = tag.indexOf(key); if (start < 0) return ''; const begin = start + key.length; const end = tag.indexOf(quote, begin); return end < 0 ? '' : tag.slice(begin, end); }; const nodes = (xmlDump.match(/<node[^>]*>/g) || []).map((tag) => { const bounds = attr(tag, 'bounds'); const coordinates = bounds.split(/[^0-9]+/).filter(Boolean).map(Number); if (coordinates.length < 4) return null; return { bounds, label: simplify(attr(tag, 'text') + ' ' + attr(tag, 'content-desc') + ' ' + attr(tag, 'hint')), packageName: attr(tag, 'package'), className: attr(tag, 'class'), clickable: attr(tag, 'clickable') === 'true', focusable: attr(tag, 'focusable') === 'true', selected: attr(tag, 'selected') === 'true' || attr(tag, 'checked') === 'true', left: coordinates[0], top: coordinates[1], right: coordinates[2], bottom: coordinates[3] }; }).filter(Boolean).filter((node) => node.packageName === 'com.facebook.katana'); const screenHeight = Math.max(...nodes.map((node) => node.bottom), 1) - Math.min(...nodes.map((node) => node.top), 0); const composers = nodes.filter((node) => /EditText|AutoCompleteTextView/.test(node.className) && node.focusable && /(escribe un comentario|write a comment|comentario|comment)/.test(node.label)); const selectedControls = nodes.filter((node) => node.clickable && node.selected); const matches = []; for (const selectedControl of selectedControls) for (const composer of composers) { const gap = composer.top - selectedControl.bottom; if (gap > 0 && gap <= screenHeight * 0.5 && selectedControl.right >= composer.left - 300 && selectedControl.left <= composer.right + 300) matches.push({ selectedControl, composer }); } const unique = Array.from(new Map(matches.map((match) => [match.selectedControl.bounds + '|' + match.composer.bounds, match])).values()); if (unique.length !== 1) { const details = selectedControls.slice(0, 8).map((node) => (node.label || node.className) + '@' + node.bounds).join('|'); throw new Error('No existe un unico like seleccionado vinculable al compositor principal. selected=' + selectedControls.length + ' composers=' + composers.length + ' details=' + details); } this.variables.facebookCommentBounds = unique[0].composer.bounds; this.variables.facebookInterface = 'strict-target-scrolled';",
