        {
          "id": "facebook_verify_comment",
          "type": "custom",
          "position": { "x": 2130, "y": 200 },
          "data": {
            "icon": "actionEval",
            "action": "Javascript",
            "options": {
              "script": "const wait = (milliseconds) => new Promise((resolve) => setTimeout(resolve, milliseconds)); const simplify = (value) => String(value || '').replace(/&amp;/g, '&').replace(/&quot;/g, ' ').replace(/&apos;/g, ' ').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim(); const expected = simplify(this.variables.commentText); const attr = (tag, name) => { const key = name + '=\"'; const start = tag.indexOf(key); if (start < 0) return ''; const begin = start + key.length; const end = tag.indexOf('\"', begin); return end < 0 ? '' : tag.slice(begin, end); }; if (expected.length < 2) throw new Error('Comentario esperado invalido.'); for (let attempt = 0; attempt < 5; attempt++) { await wait(1200); const { xmlDump } = await this.clientUiAutomator.dumpWindowHierarchy(); const nodes = (xmlDump?.match(/<node[^>]*>/g) || []).filter((tag) => attr(tag, 'package') === 'com.facebook.katana').map((tag) => ({ className: attr(tag, 'class'), text: simplify(attr(tag, 'text')), description: simplify(attr(tag, 'content-desc')) })); const editable = nodes.filter((node) => /EditText|AutoCompleteTextView/.test(node.className)); const compositorStillContainsText = editable.some((node) => node.text.includes(expected) || node.description.includes(expected)); const published = nodes.some((node) => !/EditText|AutoCompleteTextView/.test(node.className) && (node.text === expected || node.description === expected)); if (published && !compositorStillContainsText) return; } throw new Error('No se pudo verificar el comentario publicado; requiere reconciliacion manual.');",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "15",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
