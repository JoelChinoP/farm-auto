          "type": "custom",
          "position": { "x": 1440, "y": 20 },
          "data": {
            "icon": "actionEval",
            "action": "Javascript",
            "options": {
              "script": "if (this.variables.facebookInterface !== 'target-marker-bound') throw new Error('La publicacion objetivo no fue vinculada antes del desplazamiento.'); const simplify = (value) => Array.from(String(value || '').replace(/&amp;/g, '&').replace(/&quot;/g, ' ').replace(/&apos;/g, ' ').normalize('NFD')).filter((character) => { const code = character.charCodeAt(0); return code < 768 || code > 879; }).join('').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim(); const { xmlDump } = await this.clientUiAutomator.dumpWindowHierarchy(); if (!xmlDump || !xmlDump.includes('<hierarchy')) throw new Error('Facebook no expuso una interfaz accesible.'); const quote = String.fromCharCode(34); const attr = (tag, name) => { const key = name + '=' + quote; const start = tag.indexOf(key); if (start < 0) return ''; const begin = start + key.length; const end = tag.indexOf(quote, begin); return end < 0 ? '' : tag.slice(begin, end); }; const nodes = (xmlDump.match(/<node[^>]*>/g) || []).map((tag) => { const bounds = attr(tag, 'bounds'); const coordinates = bounds.split(/[^0-9]+/).filter(Boolean).map(Number); if (coordinates.length < 4) return null; return { bounds, label: simplify(attr(tag, 'text') + ' ' + attr(tag, 'content-desc') + ' ' + attr(tag, 'hint')), packageName: attr(tag, 'package'), className: attr(tag, 'class'), clickable: attr(tag, 'clickable') === 'true', selected: attr(tag, 'selected') === 'true' || attr(tag, 'checked') === 'true', left: coordinates[0], top: coordinates[1], right: coordinates[2], bottom: coordinates[3] }; }).filter(Boolean).filter((node) => node.packageName === 'com.facebook.katana'); const screenHeight = Math.max(...nodes.map((node) => node.bottom), 1) - Math.min(...nodes.map((node) => node.top), 0); const comments = nodes.filter((node) => node.clickable && /^(comentar|comment)$/.test(node.label)); const shares = nodes.filter((node) => node.clickable && /(compartir|share)/.test(node.label)); const saves = nodes.filter((node) => node.clickable && /(guardar publicacion|save post)/.test(node.label)); const composers = Array.from(new Map(nodes.filter((node) => /(escribe un comentario|write a comment)/.test(node.label)).map((node) => [node.bounds, node])).values()); const matches = []; for (const comment of comments) for (const share of shares) for (const save of saves) { const sameRow = Math.abs(comment.top - share.top) <= 20 && Math.abs(comment.top - save.top) <= 20 && Math.abs(comment.bottom - share.bottom) <= 20 && Math.abs(comment.bottom - save.bottom) <= 20; if (!sameRow || comment.right > share.left + 20 || share.right > save.left + 20) continue; const likeCandidates = nodes.filter((node) => node.clickable && /Button$/.test(node.className) && node.left < comment.left && node.right <= comment.left + 20 && Math.abs(node.top - comment.top) <= 20 && Math.abs(node.bottom - comment.bottom) <= 20).sort((a, b) => b.right - a.right); if (!likeCandidates.length) continue; for (const composer of composers) { const gap = composer.top - comment.bottom; if (gap >= 0 && gap <= screenHeight * 0.6) matches.push({ like: likeCandidates[0], composer }); } } const unique = Array.from(new Map(matches.map((match) => [match.like.bounds + '|' + match.composer.bounds, match])).values()); if (unique.length !== 1) throw new Error('No existe una unica fila principal vinculable al compositor del objetivo. rows=' + comments.length + '/' + shares.length + '/' + saves.length + ' composers=' + composers.length); const match = unique[0]; this.variables.facebookCommentBounds = match.composer.bounds; this.variables.facebookLikeBounds = match.like.bounds; this.variables.facebookLikeRequired = !match.like.selected && /^(me gusta|like)$/.test(match.like.label) ? 'true' : 'false'; this.variables.facebookInterface = 'strict-target-scrolled';",
