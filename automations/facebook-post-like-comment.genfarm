{
  "id": "control-panel-facebook-post-like-comment",
  "userId": 0,
  "name": "Control Panel - Facebook like y comentario",
  "description": "Abre una publicación de Facebook, verifica un marcador inequívoco antes del like y confirma visualmente el comentario publicado.",
  "logo": null,
  "version": "1.3.5",
  "input": [
    {
      "id": "input-content-url",
      "type": "input",
      "name": "Enlace de la publicación",
      "options": {
        "variable": { "id": "content_url", "name": "contentUrl", "label": "Enlace de la publicación", "value": "", "secret": false },
        "hideLabel": false,
        "value": "",
        "placeholder": "https://www.facebook.com/...",
        "width": null,
        "height": null,
        "labelWidth": 190,
        "maxLength": 2048,
        "minLength": 12,
        "disabled": false,
        "showCount": false
      }
    },
    {
      "id": "textarea-comment-text",
      "type": "textarea",
      "name": "Comentario aprobado",
      "options": {
        "variable": { "id": "comment_text", "name": "commentText", "label": "Comentario aprobado", "value": "", "secret": false },
        "hideLabel": false,
        "value": "",
        "placeholder": "Texto generado con DeepSeek y aprobado por el operador",
        "width": null,
        "height": 100,
        "labelWidth": 190,
        "maxLength": 500,
        "minLength": 2,
        "disabled": false,
        "showCount": true
      }
    },
    {
      "id": "input-target-marker",
      "type": "input",
      "name": "Marcador de la publicación",
      "options": {
        "variable": { "id": "target_marker", "name": "targetMarker", "label": "Marcador de la publicación", "value": "", "secret": false },
        "hideLabel": false,
        "value": "",
        "placeholder": "Frase distintiva de la publicación",
        "width": null,
        "height": null,
        "labelWidth": 190,
        "maxLength": 80,
        "minLength": 12,
        "disabled": false,
        "showCount": false
      }
    }
  ],
  "script": {
    "id": "control-panel-facebook-post-like-comment",
    "name": "Control Panel - Facebook like y comentario",
    "description": "Abre una publicación de Facebook, verifica un marcador inequívoco antes del like y confirma visualmente el comentario publicado.",
    "version": "1.3.0",
    "variables": [
      { "id": "content_url", "name": "contentUrl", "label": "Enlace de la publicación", "value": "", "secret": false },
      { "id": "comment_text", "name": "commentText", "label": "Comentario aprobado", "value": "", "secret": false },
      { "id": "target_marker", "name": "targetMarker", "label": "Marcador de la publicación", "value": "", "secret": false },
      { "id": "facebook_comment_bounds", "name": "facebookCommentBounds", "label": "Bounds del comentario", "value": "", "secret": false },
      { "id": "facebook_interface", "name": "facebookInterface", "label": "Interfaz detectada", "value": "", "secret": false }
    ],
    "flow": {
      "nodes": [
        {
          "id": "facebook_start",
          "type": "input",
          "position": { "x": 60, "y": 200 },
          "data": { "action": "Start", "options": {}, "successNode": "facebook_open_url", "failNode": null },
          "label": "Start",
          "sourcePosition": "right",
          "targetPosition": "left",
          "deletable": false,
          "class": ""
        },
        {
          "id": "facebook_open_url",
          "type": "custom",
          "position": { "x": 290, "y": 200 },
          "data": {
            "icon": "terminal",
            "action": "Adb",
            "options": { "command": "am start -W -S -a android.intent.action.VIEW -d '${contentUrl}' -n com.facebook.katana/.IntentUriHandler", "outputVariable": null, "disabled": false, "nodeSleep": "0", "nodeTimeout": "15", "timeoutNextNode": "failNode", "breakpoint": false, "timeoutAdbReconnect": "30", "nodeLog": "" },
            "successNode": "facebook_wait",
            "failNode": null
          },
          "label": "Abrir publicación exacta",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "facebook_wait",
          "type": "custom",
          "position": { "x": 520, "y": 200 },
          "data": {
            "icon": "actionPause",
            "action": "Pause",
            "options": { "timeoutType": "fixed", "timeout": "15", "timeoutFrom": "1", "timeoutTo": "3", "disabled": false, "nodeSleep": "0", "nodeTimeout": "20", "timeoutNextNode": "failNode", "breakpoint": false, "timeoutAdbReconnect": "30", "nodeLog": "" },
            "successNode": "facebook_refresh_visible_target",
            "failNode": null
          },
          "label": "Esperar publicación",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "facebook_bind_visible_target",
          "type": "custom",
          "position": { "x": 750, "y": 20 },
          "data": {
            "icon": "actionEval",
            "action": "Javascript",
            "options": {
              "script": "const simplify = (value) => Array.from(String(value || '').replace(/&#([0-9]+);/g, (_match, code) => String.fromCharCode(Number(code))).replace(/&amp;/g, '&').replace(/&quot;/g, ' ').replace(/&apos;/g, ' ').normalize('NFD')).filter((character) => { const code = character.charCodeAt(0); return code < 768 || code > 879; }).join('').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim(); const marker = simplify('${targetMarker}'); if (marker.length < 12) throw new Error('Marcador objetivo invalido.'); const { xmlDump } = await this.clientUiAutomator.dumpWindowHierarchy(); if (!xmlDump || !xmlDump.includes('<hierarchy')) throw new Error('Facebook no expuso una interfaz accesible.'); const quote = String.fromCharCode(34); const attr = (tag, name) => { const key = name + '=' + quote; const start = tag.indexOf(key); if (start < 0) return ''; const begin = start + key.length; const end = tag.indexOf(quote, begin); return end < 0 ? '' : tag.slice(begin, end); }; const labels = (xmlDump.match(/<node[^>]*>/g) || []).filter((tag) => attr(tag, 'package') === 'com.facebook.katana').map((tag) => simplify(attr(tag, 'text') + ' ' + attr(tag, 'content-desc') + ' ' + attr(tag, 'hint'))).filter(Boolean); const visibleText = labels.join(' '); let cursor = 0; const matched = marker.split(' ').every((word) => { const index = visibleText.indexOf(word, cursor); if (index < 0) return false; cursor = index + word.length; return true; }); if (!matched) throw new Error('La publicacion objetivo no esta visible; accesibilidad: ' + labels.slice(0, 12).join(' | ').slice(0, 600)); this.variables.facebookInterface = 'target-marker-bound';",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "30",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "facebook_scroll_target",
            "failNode": null
          },
          "label": "Vincular marcador visible",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "facebook_refresh_visible_target",
          "type": "custom",
          "position": { "x": 750, "y": 20 },
          "data": {
            "icon": "actionEval",
            "action": "Javascript",
            "options": {
              "script": "const wait = (milliseconds) => new Promise((resolve) => setTimeout(resolve, milliseconds)); const simplify = (value) => Array.from(String(value || '').replace(/&#([0-9]+);/g, (_match, code) => String.fromCharCode(Number(code))).replace(/&amp;/g, '&').replace(/&quot;/g, ' ').replace(/&apos;/g, ' ').normalize('NFD')).filter((character) => { const code = character.charCodeAt(0); return code < 768 || code > 879; }).join('').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim(); const marker = simplify('${targetMarker}'); if (marker.length < 12) throw new Error('Marcador objetivo invalido.'); const quote = String.fromCharCode(34); const attr = (tag, name) => { const key = name + '=' + quote; const start = tag.indexOf(key); if (start < 0) return ''; const begin = start + key.length; const end = tag.indexOf(quote, begin); return end < 0 ? '' : tag.slice(begin, end); }; let lastLabels = []; for (let attempt = 0; attempt < 8; attempt++) { const { xmlDump } = await this.clientUiAutomator.dumpWindowHierarchy(); if (xmlDump && xmlDump.includes('<hierarchy')) { const labels = (xmlDump.match(/<node[^>]*>/g) || []).filter((tag) => attr(tag, 'package') === 'com.facebook.katana').map((tag) => simplify(attr(tag, 'text') + ' ' + attr(tag, 'content-desc') + ' ' + attr(tag, 'hint'))).filter(Boolean); lastLabels = labels; const visibleText = labels.join(' '); let cursor = 0; const matched = marker.split(' ').every((word) => { const index = visibleText.indexOf(word, cursor); if (index < 0) return false; cursor = index + word.length; return true; }); if (matched) { this.variables.facebookInterface = 'target-marker-bound'; return; } } await wait(1000); } throw new Error('La publicacion objetivo no esta visible tras refrescar accesibilidad: ' + lastLabels.slice(0, 12).join(' | ').slice(0, 600));",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "30",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "facebook_scroll_target",
            "failNode": null
          },
          "label": "Refrescar y vincular marcador",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "facebook_scroll_target",
          "type": "custom",
          "position": { "x": 980, "y": 20 },
          "data": {
            "icon": "terminal",
            "action": "Adb",
            "options": { "command": "input swipe 540 1650 540 650 500", "outputVariable": null, "disabled": false, "nodeSleep": "0", "nodeTimeout": "15", "timeoutNextNode": "failNode", "breakpoint": false, "timeoutAdbReconnect": "30", "nodeLog": "" },
            "successNode": "facebook_scroll_wait",
