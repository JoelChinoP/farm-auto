            "action": "Javascript",
            "options": {
              "script": "const simplify = (value) => String(value || '').replace(/&amp;/g, '&').replace(/&quot;/g, ' ').replace(/&apos;/g, ' ').replace(/[^a-zA-Z0-9 ]+/g, ' ').trim(); const { xmlDump } = await this.clientUiAutomator.dumpWindowHierarchy(); const quote = String.fromCharCode(34); const attr = (tag, name) => { const key = name + '=' + quote; const start = tag.indexOf(key); if (start < 0) return ''; const begin = start + key.length; const end = tag.indexOf(quote, begin); return end < 0 ? '' : tag.slice(begin, end); }; const rows = (xmlDump.match(/<node[^>]*>/g) || []).map((tag) => ({ label: simplify(attr(tag, 'text') + ' ' + attr(tag, 'content-desc') + ' ' + attr(tag, 'hint')), packageName: attr(tag, 'package'), className: attr(tag, 'class').split('.').pop(), clickable: attr(tag, 'clickable'), focusable: attr(tag, 'focusable'), selected: attr(tag, 'selected'), checked: attr(tag, 'checked'), bounds: attr(tag, 'bounds') })).filter((node) => node.packageName === 'com.facebook.katana' && (node.label || node.clickable === 'true' || node.focusable === 'true')); const details = rows.slice(-45).map((node) => [node.label || '_', node.className, 'c' + node.clickable, 'f' + node.focusable, 's' + node.selected, 'k' + node.checked, node.bounds].join('~')).join('|'); throw new Error('SCROLLED_UI=' + details);",
              "disabled": false,
