          "position": { "x": 1210, "y": 20 },
          "data": {
            "icon": "actionPause",
            "action": "Pause",
            "options": { "timeoutType": "fixed", "timeout": "2", "timeoutFrom": "1", "timeoutTo": "3", "disabled": false, "nodeSleep": "0", "nodeTimeout": "10", "timeoutNextNode": "failNode", "breakpoint": false, "timeoutAdbReconnect": "30", "nodeLog": "" },
            "successNode": "facebook_bind_scrolled_controls",
            "failNode": null
          },
          "label": "Esperar barra de acciones",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "facebook_target_action_after_scroll",
          "type": "custom",
          "position": { "x": 1440, "y": 20 },
          "data": {
            "icon": "actionEval",
            "action": "Javascript",
            "options": {
              "script": "if (this.variables.facebookInterface !== 'target-marker-bound') throw new Error('La publicacion objetivo no fue vinculada antes del desplazamiento.'); const simplify = (value) => Array.from(String(value || '').replace(/&amp;/g, '&').replace(/&quot;/g, ' ').replace(/&apos;/g, ' ').normalize('NFD')).filter((character) => { const code = character.charCodeAt(0); return code < 768 || code > 879; }).join('').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim(); const { xmlDump } = await this.clientUiAutomator.dumpWindowHierarchy(); if (!xmlDump || !xmlDump.includes('<hierarchy')) throw new Error('Facebook no expuso una interfaz accesible.'); const quote = String.fromCharCode(34); const attr = (tag, name) => { const key = name + '=' + quote; const start = tag.indexOf(key); if (start < 0) return ''; const begin = start + key.length; const end = tag.indexOf(quote, begin); return end < 0 ? '' : tag.slice(begin, end); }; const nodes = (xmlDump.match(/<node[^>]*>/g) || []).map((tag) => { const bounds = attr(tag, 'bounds'); const coordinates = bounds.split(/[^0-9]+/).filter(Boolean).map(Number); if (coordinates.length < 4) return null; return { bounds, label: simplify(attr(tag, 'text') + ' ' + attr(tag, 'content-desc') + ' ' + attr(tag, 'hint')), packageName: attr(tag, 'package'), className: attr(tag, 'class'), clickable: attr(tag, 'clickable') === 'true', focusable: attr(tag, 'focusable') === 'true', selected: attr(tag, 'selected') === 'true' || attr(tag, 'checked') === 'true', left: coordinates[0], top: coordinates[1], right: coordinates[2], bottom: coordinates[3] }; }).filter(Boolean).filter((node) => node.packageName === 'com.facebook.katana'); const screenHeight = Math.max(...nodes.map((node) => node.bottom), 1) - Math.min(...nodes.map((node) => node.top), 0); const composers = nodes.filter((node) => /EditText|AutoCompleteTextView/.test(node.className) && node.focusable && /(escribe un comentario|write a comment|comentario|comment)/.test(node.label)); const likes = nodes.filter((node) => node.clickable && /(me gusta|like|liked|unlike|ya no me gusta|eliminar me gusta|remove like)/.test(node.label)); const pairs = []; for (const like of likes) for (const composer of composers) { const gap = composer.top - like.bottom; if (like.right <= composer.left + 80 && gap >= 80 && gap <= screenHeight * 0.65) pairs.push({ like, composer }); } const unique = pairs.filter((pair, index) => pairs.findIndex((item) => item.like.bounds === pair.like.bounds && item.composer.bounds === pair.composer.bounds) === index); if (unique.length !== 1) throw new Error('No existe una unica barra principal vinculable al compositor del objetivo.'); const pair = unique[0]; this.variables.facebookCommentBounds = pair.composer.bounds; this.variables.facebookInterface = 'strict-target-scrolled'; const alreadyLiked = pair.like.selected || /(liked|unlike|ya no me gusta|eliminar me gusta|remove like)/.test(pair.like.label); if (!alreadyLiked) { const target = await this.clientUiAutomator.xpath('//*[@bounds=' + quote + pair.like.bounds + quote + ']', xmlDump); if (!target) throw new Error('No se pudo fijar el Like principal del objetivo.'); await target.click(); }",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "30",
              "timeoutNextNode": "failNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "facebook_like_pause",
            "failNode": null
          },
          "label": "Validar acciones tras desplazar",
          "sourcePosition": "right",
          "targetPosition": "left",
