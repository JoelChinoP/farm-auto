{
  "id": "control-panel-open-social-content",
  "userId": 0,
  "name": "Control Panel - Abrir contenido social",
  "description": "Abre un enlace HTTPS validado en TikTok o Facebook.",
  "logo": null,
  "version": "1.1.0",
  "input": [
    {
      "id": "input-content-url",
      "type": "input",
      "name": "Enlace de contenido",
      "options": {
        "variable": {
          "id": "content_url",
          "name": "contentUrl",
          "label": "Enlace de contenido",
          "value": "",
          "secret": false
        },
        "hideLabel": false,
        "value": "",
        "placeholder": "https://www.tiktok.com/... o https://www.facebook.com/...",
        "width": null,
        "height": null,
        "labelWidth": 160,
        "maxLength": null,
        "minLength": null,
        "disabled": false,
        "showCount": false
      }
    },
    {
      "id": "select-package-name",
      "type": "select",
      "name": "Aplicación",
      "options": {
        "variable": {
          "id": "package_name",
          "name": "packageName",
          "label": "Paquete Android",
          "value": "",
          "secret": false
        },
        "hideLabel": false,
        "value": null,
        "options": [
          {
            "label": "TikTok",
            "value": "com.zhiliaoapp.musically"
          },
          {
            "label": "Facebook",
            "value": "com.facebook.katana"
          }
        ],
        "isMultiple": false,
        "placeholder": "Seleccione una aplicación",
        "width": null,
        "height": null,
        "labelWidth": 160
      }
    }
  ],
  "script": {
    "id": "control-panel-open-social-content",
    "name": "Control Panel - Abrir contenido social",
    "description": "Abre un enlace HTTPS validado en TikTok o Facebook.",
    "version": "1.1.0",
    "variables": [
      {
        "id": "content_url",
        "name": "contentUrl",
        "label": "Enlace de contenido",
        "value": "",
        "secret": false
      },
      {
        "id": "package_name",
        "name": "packageName",
        "label": "Paquete Android",
        "value": "",
        "secret": false
      }
    ],
    "flow": {
      "nodes": [
        {
          "id": "social_start",
          "type": "input",
          "position": { "x": 80, "y": 180 },
          "data": {
            "action": "Start",
            "options": {},
            "successNode": "social_open",
            "failNode": null
          },
          "label": "Start",
          "sourcePosition": "right",
          "targetPosition": "left",
          "deletable": false,
          "class": ""
        },
        {
          "id": "social_open",
          "type": "custom",
          "position": { "x": 300, "y": 180 },
          "data": {
            "icon": "play",
            "action": "StartApp",
            "options": {
              "packageName": "${packageName}",
              "timeout": "30",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "45",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "social_content",
            "failNode": null
          },
          "label": "Abrir aplicación",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_content",
          "type": "custom",
          "position": { "x": 540, "y": 180 },
          "data": {
            "icon": "terminal",
            "action": "Adb",
            "options": {
              "command": "am start -W -a android.intent.action.VIEW -d '${contentUrl}' -p ${packageName}",
              "outputVariable": null,
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "45",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "social_log",
            "failNode": null
          },
          "label": "Abrir enlace validado",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_log",
          "type": "custom",
          "position": { "x": 780, "y": 180 },
          "data": {
            "icon": "log",
            "action": "Log",
            "options": {
              "log": "Contenido abierto para revisión e interacción manual.",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "30",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "social_stop",
            "failNode": null
          },
          "label": "Registrar resultado",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "social_stop",
          "type": "custom",
          "position": { "x": 1020, "y": 180 },
          "data": {
            "icon": "stop",
            "action": "Stop",
            "options": {},
            "successNode": null,
            "failNode": null
          },
          "label": "Stop",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        }
      ],
      "edges": [
        {
          "id": "edge-social-start-open",
          "type": "custom",
          "source": "social_start",
          "target": "social_open",
          "sourceHandle": "social_start",
          "targetHandle": "success",
          "data": { "sourceHandle": "social_start", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-social_start target-social_open"
        },
        {
          "id": "edge-social-open-content",
          "type": "custom",
          "source": "social_open",
          "target": "social_content",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-social_open target-social_content"
        },
        {
          "id": "edge-social-content-log",
          "type": "custom",
          "source": "social_content",
          "target": "social_log",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-social_content target-social_log"
        },
        {
          "id": "edge-social-log-stop",
          "type": "custom",
          "source": "social_log",
          "target": "social_stop",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-social_log target-social_stop"
        }
      ]
    }
  }
}
