{
  "id": "control-panel-facebook-context-extract",
  "userId": 0,
  "name": "Control Panel - Extraer contexto de Facebook",
  "description": "Lee el texto accesible visible en Facebook sin realizar interacciones publicas.",
  "logo": null,
  "version": "1.0.0",
  "script": {
    "id": "control-panel-facebook-context-extract",
    "name": "Control Panel - Extraer contexto de Facebook",
    "description": "Lee el texto accesible visible en Facebook sin realizar interacciones publicas.",
    "version": "1.0.0",
    "variables": [
      {
        "id": "facebook_context",
        "name": "facebookContext",
        "label": "Contexto de Facebook",
        "value": "",
        "secret": false
      }
    ],
    "flow": {
      "nodes": [
        {
          "id": "context_start",
          "type": "input",
          "position": { "x": 60, "y": 180 },
          "data": {
            "action": "Start",
            "options": {},
            "successNode": "context_extract",
            "failNode": null
          },
          "label": "Start",
          "sourcePosition": "right",
          "targetPosition": "left",
          "deletable": false,
          "class": ""
        },
        {
          "id": "context_extract",
          "type": "custom",
          "position": { "x": 310, "y": 180 },
          "data": {
            "icon": "actionEval",
            "action": "Javascript",
            "options": {
              "script": "let { xmlDump } = await this.clientUiAutomator.dumpWindowHierarchy(); if (!xmlDump || !xmlDump.includes('<hierarchy')) throw new Error('Android no devolvio contenido accesible.'); const dismissXpath = \"//*[@text='Ahora no' or @content-desc='Ahora no' or @text='Not now' or @content-desc='Not now' or @text='Omitir' or @content-desc='Omitir' or @text='Skip' or @content-desc='Skip' or @text='No permitir' or @content-desc='No permitir' or @text=\\\"Don't allow\\\" or @content-desc=\\\"Don't allow\\\"]\"; for (let attempt = 0; attempt < 4; attempt++) { const dismiss = await this.clientUiAutomator.xpath(dismissXpath, xmlDump); if (!dismiss) break; await dismiss.click(); await new Promise((resolve) => setTimeout(resolve, 1200)); ({ xmlDump } = await this.clientUiAutomator.dumpWindowHierarchy()); } const seeMore = await this.clientUiAutomator.xpath(\"//*[@text='Ver m\u00e1s' or @content-desc='Ver m\u00e1s' or @text='See more' or @content-desc='See more']\", xmlDump); if (seeMore) { await seeMore.click(); await new Promise((resolve) => setTimeout(resolve, 700)); ({ xmlDump } = await this.clientUiAutomator.dumpWindowHierarchy()); } const ignored = new Set(['facebook', 'like', 'me gusta', 'comment', 'comentar', 'share', 'compartir', 'send', 'enviar', 'post', 'publicar', 'write a comment', 'escribe un comentario', 'see more', 'ver m\u00e1s', 'ver mas', 'back', 'atr\u00e1s', 'atras', 'close', 'cerrar', 'not now', 'ahora no', 'skip', 'omitir', 'no permitir', \"don't allow\", 'continue', 'continuar', 'add friend', 'add as friend', 'a\u00f1adir como amigo(a)', 'agregar como amigo(a)']); const ignoredFragments = ['a\u00f1\u00e1delo como amigo para que sea a\u00fan m\u00e1s f\u00e1cil compartir contenido', 'add them as a friend to make sharing content even easier', 'permite el acceso a tus contactos para encontrar personas', 'sube tus contactos para saber qui\u00e9nes est\u00e1n en facebook', 'informaci\u00f3n sobre la subida de contactos']; const boundaries = new Set(['detalles del reel', 'reel details']); const decode = (value) => value.replaceAll('&quot;', '\"').replaceAll('&apos;', \"'\").replaceAll('&lt;', '<').replaceAll('&gt;', '>').replaceAll('&amp;', '&').replace(/&#(\\d+);/g, (_, code) => String.fromCodePoint(Number(code))).replace(/&#x([0-9a-f]+);/gi, (_, code) => String.fromCodePoint(Number.parseInt(code, 16))); const values = []; const seen = new Set(); for (const node of xmlDump.matchAll(/<node\\b[^>]*>/g)) { const packageName = node[0].match(/\\bpackage=\"([^\"]*)\"/)?.[1]; if (packageName && packageName !== 'com.facebook.katana') continue; for (const match of node[0].matchAll(/(?:text|content-desc)=\"([^\"]*)\"/g)) { const value = decode(match[1]).replace(/\\s+/g, ' ').trim(); const normalized = value.toLocaleLowerCase('es'); if (value.length < 2 || ignored.has(normalized) || ignoredFragments.some((fragment) => normalized.includes(fragment)) || seen.has(normalized)) continue; seen.add(normalized); values.push(value); } } let context = ''; for (const value of values) { if (boundaries.has(value.toLocaleLowerCase('es'))) break; const candidate = context ? context + '\\n' + value : value; if (candidate.length > 1200) { if (!context) context = value.slice(0, 1200).trim(); break; } context = candidate; } if (context.length < 5) throw new Error('No se encontro texto accesible de Facebook.'); this.variables.facebookContext = context;",
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "30",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "context_store",
            "failNode": null
          },
          "label": "Leer contexto accesible",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "context_store",
          "type": "custom",
          "position": { "x": 560, "y": 180 },
          "data": {
            "icon": "file",
            "action": "InsertData",
            "options": {
              "dataRows": [
                { "column": "outputType", "value": "facebook-context-v1" },
                { "column": "context", "value": "${facebookContext}" }
              ],
              "disabled": false,
              "nodeSleep": "0",
              "nodeTimeout": "15",
              "timeoutNextNode": "successNode",
              "breakpoint": false,
              "timeoutAdbReconnect": "30",
              "nodeLog": ""
            },
            "successNode": "context_stop",
            "failNode": null
          },
          "label": "Guardar contexto",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        },
        {
          "id": "context_stop",
          "type": "custom",
          "position": { "x": 810, "y": 180 },
          "data": {
            "icon": "actionStop",
            "action": "Stop",
            "options": {},
            "successNode": null,
            "failNode": null
          },
          "label": "Stop",
          "sourcePosition": "right",
          "targetPosition": "left",
          "class": ""
        }
      ],
      "edges": [
        {
          "id": "edge-context-start-extract",
          "type": "custom",
          "source": "context_start",
          "target": "context_extract",
          "sourceHandle": "context_start",
          "targetHandle": "success",
          "data": { "sourceHandle": "context_start", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-context_start target-context_extract"
        },
        {
          "id": "edge-context-extract-store",
          "type": "custom",
          "source": "context_extract",
          "target": "context_store",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-context_extract target-context_store"
        },
        {
          "id": "edge-context-store-stop",
          "type": "custom",
          "source": "context_store",
          "target": "context_stop",
          "sourceHandle": "success",
          "targetHandle": "success",
          "data": { "sourceHandle": "success", "targetHandle": "success" },
          "label": "",
          "style": { "stroke": "#62fcaf", "strokeWidth": 2 },
          "animated": true,
          "class": "source-context_store target-context_stop"
        }
      ]
    }
  }
}
